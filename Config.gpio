
PinSettings evbe7000s
Board "myBoard.gpio_board" version "2.0.0"

CAN1 {
	in CAN1_RX -> E7_1 as CAN1_RX
	IO
		MODER4 = "Alternate",
		OT4 = "PushPull",
		OSPEEDR4 = "Low",
		PUPDR4 = "Floating",
		AFRL4 = "6",
		IHYSTR4 = "CMOS",
		TR4 = "Enable",
		SFS4 = "Disabled",
		SFV4 = "Low"
	;
	out CAN1_TX -> E7_2 as CAN1_TX
	IO
		MODER5 = 'Alternate',
		OT5 = 'PushPull',
		OSPEEDR5 = 'Low',
		PUPDR5 = 'Floating',
		AFRL5 = 6,
		IHYSTR5 = 'CMOS',
		TR5 = 'Disabled',
		SFS5 = 'Disabled',
		SFV5 = 'Low'
	;
}

