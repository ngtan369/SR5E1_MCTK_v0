  36:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c **** /** @defgroup dac_common_ui Common DAC User Interface
  37:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c ****   * @brief DAC User Interface implementation
  38:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c ****   *
  39:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c ****   * Digital to Analog Converter common component. In Motor Control context, the DAC is used for
  40:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c ****   * debug purposes by outputting information with low overhead. It is particularly useful to
  41:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c ****   * output fast changing analog-like data as voltage references or measured currents to compare
  42:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c ****   * them with measurements made with other means, for instance.
  43:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c ****   *
  44:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c ****   * @{
  45:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/dac_common_ui.c ****   */
