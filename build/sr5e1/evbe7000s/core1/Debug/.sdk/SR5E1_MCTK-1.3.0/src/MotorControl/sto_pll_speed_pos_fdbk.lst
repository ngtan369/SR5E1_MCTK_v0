 329:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c **** /**
 330:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   * @brief  This method must be called - at least - with the same periodicity
 331:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   *         on which speed control is executed. It computes and returns - through
 332:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   *         parameter hMecSpeedUnit - the rotor average mechanical speed,
 333:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   *         expressed in Unit. Average is computed considering a FIFO depth
 334:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   *         equal to bSpeedBufferSizeUnit. Moreover it also computes and returns
 335:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   *         the reliability state of the sensor.
 336:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   * @param  pHandle: handler of the current instance of the STO component
 337:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   * @param  pMecSpeedUnit pointer to int16_t, used to return the rotor average
 338:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   *         mechanical speed (expressed in the unit defined by #SPEED_UNIT)
 339:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   * @retval bool speed sensor reliability, measured with reference to parameters
 340:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   *         bReliability_hysteresys, hVariancePercentage and bSpeedBufferSize
 341:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   *         true = sensor information is reliable
 342:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   *         false = sensor information is not reliable
 343:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/sto_pll_speed_pos_fdbk.c ****   */
