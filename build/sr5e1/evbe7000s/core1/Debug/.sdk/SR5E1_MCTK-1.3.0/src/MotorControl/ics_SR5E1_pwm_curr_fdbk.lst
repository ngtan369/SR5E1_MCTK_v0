1431:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** //SR5E1_Fix: check the following times/cycles for SR5E1
1432:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /* Note: Only ADC peripheral HW delays are defined in ADC LL driver driver,   */
1433:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       not timeout values.                                                  */
1434:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       Timeout values for ADC operations are dependent to device clock      */
1435:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       configuration (system clock versus ADC clock),                       */
1436:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       and therefore must be defined in user application.                   */
1437:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       Indications for estimation of ADC timeout delays, for this           */
1438:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       SR5E1 series:                                                        */
1439:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       - ADC calibration time: maximum delay is 112/fADC.                   */
1440:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*         (refer to device datasheet, parameter "tCAL")                      */
1441:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       - ADC enable time: maximum delay is 1 conversion cycle.              */
1442:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*         (refer to device datasheet, parameter "tSTAB")                     */
1443:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       - ADC disable time: maximum delay should be a few ADC clock cycles   */
1444:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       - ADC stop conversion time: maximum delay should be a few ADC clock  */
1445:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*         cycles                                                             */
1446:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*       - ADC conversion time: duration depending on ADC clock and ADC       */
1447:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*         configuration.                                                     */
1448:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /*         (refer to device reference manual, section "Timing")               */
