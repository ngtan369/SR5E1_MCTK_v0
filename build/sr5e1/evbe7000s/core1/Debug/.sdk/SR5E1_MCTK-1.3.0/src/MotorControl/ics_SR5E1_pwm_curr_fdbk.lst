4130:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_TRIG_EXT_HRTIM2_TRG6
4131:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_TRIG_EXT_HRTIM2_TRG7
4132:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_INJ_TRIG_EXT_HRTIM2_TRG8
