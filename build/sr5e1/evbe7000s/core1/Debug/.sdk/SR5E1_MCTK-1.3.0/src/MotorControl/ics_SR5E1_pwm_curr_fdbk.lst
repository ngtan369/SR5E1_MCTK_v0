3845:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** 
3846:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   return (uint32_t)((READ_BIT(*preg,
