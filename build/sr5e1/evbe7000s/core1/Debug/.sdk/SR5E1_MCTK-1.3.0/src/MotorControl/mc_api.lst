  11:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** /**
  12:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** *   @file    mc_api.c
  13:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** *   @version M4_VERSION
  14:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** *   @brief   This file implements the high level interface of the Stellar Motor Control.
  15:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** *
  16:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** *   @details This file implements the high level interface of the Stellar Motor Control.
  17:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** *
  18:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****  */
  19:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** 
  20:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** #include "mc_interface.h"
  21:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** #include "mc_api.h"
  22:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** #include "mc_config.h"
  23:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** 
  24:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** /** @addtogroup STELLAR_PMSM_MC_APPLICATION
  25:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * @{
  26:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   */
  27:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** 
  28:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** /** @defgroup MCIAPI Motor Control API
  29:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  30:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * @brief High level Programming Interface of the Stellar Motor Control
  31:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  32:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *  This interface allows for performing basic operations on the motor(s) driven by an
  33:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * Motor Control SDK based application. With it, motors can be started and stopped, speed or
  34:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * torque ramps can be programmed and executed and information on the state of the motors can
  35:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * be retrieved, among others.
  36:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  37:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *  This interface consists in functions that target a specific motor, indicated in their name.
  38:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * These functions aims at being the main interface used by an Application to control motors.
  39:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  40:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *  The current Motor Control API can cope with up to 2 motors.
  41:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * @{
  42:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   */
  43:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** 
  44:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** extern MCI_Handle_t * pMCI[NBR_OF_MOTORS];
  45:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** 
  46:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** /**
  47:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * @brief  Initiates the start-up procedure for Motor 1
  48:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  49:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * If the state machine of Motor 1 is in #IDLE state, the command is immediately
  50:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * executed. Otherwise the command is discarded. The Application can check the
  51:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * return value to know whether the command was executed or discarded.
  52:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  53:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * One of the following commands must be executed before calling MC_StartMotor1():
  54:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  55:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * - MC_ProgramSpeedRampMotor1()
  56:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * - MC_ProgramTorqueRampMotor1()
  57:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * - MC_SetCurrentReferenceMotor1()
  58:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  59:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * Failing to do so results in an unpredictable behaviour.
  60:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  61:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * @note The MC_StartMotor1() command only triggers the start-up procedure:
  62:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * It moves Motor 1's state machine from the #IDLE to the #IDLE_START state and then
  63:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * returns. It is not blocking the application until the motor is indeed running.
  64:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * To know if it is running, the application can query Motor 1's state machine and
  65:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * check if it has reached the #RUN state. See MC_GetSTMStateMotor1() for more details.
  66:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   *
  67:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   * @retval returns true if the command is successfully executed, false otherwise.
  68:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c ****   */
  69:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** __weak bool MC_StartMotor1(void)
  70:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** {
  82              		.loc 1 70 1
  83              		.cfi_startproc
