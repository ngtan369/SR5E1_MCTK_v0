  87              		.cfi_def_cfa_offset 8
  88              		.cfi_offset 3, -8
  89              		.cfi_offset 14, -4
  71:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** 	return MCI_StartMotor( pMCI[M1] );
  90              		.loc 1 71 9
