 162 000c 1346     		mov	r3, r2	@ movhi
 163 000e ADF80430 		strh	r3, [sp, #4]	@ movhi
 127:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_api.c **** 	MCI_ExecSpeedRamp( pMCI[M1], hFinalSpeed, hDurationms );
 164              		.loc 1 127 2
 165 0012 064B     		ldr	r3, .L10
 166 0014 1B68     		ldr	r3, [r3]
 167 0016 BDF80420 		ldrh	r2, [sp, #4]
