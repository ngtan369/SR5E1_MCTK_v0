  96:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** 
  97:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** /**
  98:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****  * @brief Sets the PWM duty cycles
  99:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****  *
 100:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****  *
 101:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****  */
 102:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** 
 103:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** /**
 104:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @brief  Converts input voltages @f$ V_{\alpha} @f$ and @f$ V_{\beta} @f$ into PWM duty cycles
 105:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *         and feed them to the inverter.
 106:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @param  pHandle handler on the target PWMC component.
 107:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @param  Valfa_beta Voltage Components expressed in the @f$(\alpha, \beta)@f$ reference frame
 108:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
 109:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * This function computes the the time during wIch the transistors of each phase are to be switche
 110:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * a PWM cycle in order to achieve the reference phase voltage set by @p Valfa_beta. Then, the fun
 111:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * programs the resulting duty cycles in the related timer channels. It also sets the phase curren
 112:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * sampling point for the next PWM cycle accordingly.
 113:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
 114:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * This function is used in the FOC frequency loop and needs to complete before the next PWM cycle
 115:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * so that the duty cycles it computes can be taken into account. Failing to do so (for instance b
 116:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * the PWM Frequency is too high) results in the functions returning #MC_FOC_DURATION wIch entails
 117:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * Motor Control Fault that stops the motor.
 118:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
 119:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @retval Returns #MC_NO_ERROR if no error occurred or #MC_FOC_DURATION if the duty cycles were
 120:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *         set too late for being taken into account in the next PWM cycle.
 121:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   */
 122:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #if defined (MCTK_ITCM)
 123:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** __weak uint16_t __attribute__((section(".itcm"))) PWMC_SetPhaseVoltage( PWMC_Handle_t * pHandle, al
 124:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #else
 125:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** __weak uint16_t PWMC_SetPhaseVoltage( PWMC_Handle_t * pHandle, alphabeta_t Valfa_beta )
 126:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #endif  
 127:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** {
 119              		.loc 1 127 1
 120              		.cfi_startproc
 121              		@ args = 0, pretend = 0, frame = 40
