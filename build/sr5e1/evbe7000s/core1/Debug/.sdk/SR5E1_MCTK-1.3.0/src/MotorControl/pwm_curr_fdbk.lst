  11:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** /**
  12:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** *   @file    pwm_curr_fdbk.c
  13:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** *   @version M4_VERSION
  14:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** *   @brief   This file provides firmware functions that implement the features
  15:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** *            of the PWM & Current Feedback component of the Stellar Motor Control.
  16:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** *
  17:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** *   @details This file provides firmware functions that implement the features
  18:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** *            of the PWM & Current Feedback component of the Stellar Motor Control.
  19:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** *
  20:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****  */
  21:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** 
  22:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** /* Includes ------------------------------------------------------------------*/
  23:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #include "pwm_curr_fdbk.h"
  24:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #include "mc_type.h"
  25:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #include "mc_config.h"
  26:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** /** @addtogroup STELLAR_PMSM_MC_FOC_LIBRARY
  27:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @{
  28:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   */
  29:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** 
  30:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** /** @defgroup pwm_curr_fdbk PWM & Current Feedback
  31:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  32:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @brief PWM & Current Feedback components of the Stellar Motor Control
  33:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  34:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * These components fulfill two functions in a Motor Control subsystem:
  35:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  36:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * - The generation of the Space Vector Pulse Width Modulation on the motor's phases
  37:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * - The sampling of the actual motor's phases current
  38:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  39:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * Both these features are closely related as the instants when the values of the phase currents
  40:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * should be sampled by the ADC channels are basically triggered by the timers used to generate
  41:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * the duty cycles for the PWM.
  42:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  43:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * Several implementation of PWM and Current Feedback components are provided by the Motor Control
  44:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * SDK to account for the specificities of the application:
  45:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  46:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * - The selected MCU: the number of ADCs available on a given MCU, the presence of internal
  47:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * comparators or OpAmps, for instance, lead to different implementation of this feature
  48:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * - The Current sensing topology also has an impact on the firmware: implementations are provided
  49:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * for Insulated Current Sensors, Single Shunt and Three Shunt resistors current sensing topologie
  50:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  51:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * The choice of the implementation mostly depend on these two factors and is performed by the
  52:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * Motor Control Workbench tool.
  53:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  54:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * All these implementations are built on a base PWM & Current Feedback component that they extend
  55:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * and that provides the functions and data that are common to all of them. This base component is
  56:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * never used directly as it does not provide a complete implementation of the features. Rather,
  57:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * its handle structure (PWMC_Handle) is reused by all the PWM & Current Feedback specific
  58:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * implementations and the functions it provides form the API of the PWM and Current feedback feat
  59:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * Calling them results in calling functions of the component that actually implement the feature.
  60:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * See PWMC_Handle for more details on this mechanism.
  61:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @{
  62:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   */
  63:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** /* Only for debug */
  64:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** /* #define DUTY_PHA_DEBUG */
  65:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** 
  66:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #if defined (DUTY_PHA_DEBUG)
  67:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #define DUTY_PHA_DEBUG_SIZE 1200
  68:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** uint16_t DutyPhABufferDebug[DUTY_PHA_DEBUG_SIZE];
  69:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** uint16_t DutyPhBBufferDebug[DUTY_PHA_DEBUG_SIZE];
  70:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** uint16_t DutyPhCBufferDebug[DUTY_PHA_DEBUG_SIZE];
  71:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** uint32_t wIndex;
  72:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #endif
  73:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** 
  74:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** /**
  75:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @brief Returns the phase current of the motor as read by the ADC (in s16A unit)
  76:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  77:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * The function actually returns the current values of phase A & B. Phase C current
  78:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * can be deduced thanks to the formula:
  79:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  80:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @f[
  81:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * I_{C} = -I_{A} - I_{C}
  82:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @f]
  83:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *
  84:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @param  pHandle handle on the target PWMC component
  85:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   * @param  pStator_Currents Pointer to the structure that will receive motor current
  86:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c ****   *         of phase A and B in ElectricalValue format.
  87:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** */
  88:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #if defined (MCTK_ITCM)
  89:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** __weak void __attribute__((section(".itcm"))) PWMC_GetPhaseCurrents( PWMC_Handle_t * pHandle, ab_t 
  90:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #else
  91:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** __weak void PWMC_GetPhaseCurrents( PWMC_Handle_t * pHandle, ab_t * Iab )
  92:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** #endif
  93:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/pwm_curr_fdbk.c **** {
