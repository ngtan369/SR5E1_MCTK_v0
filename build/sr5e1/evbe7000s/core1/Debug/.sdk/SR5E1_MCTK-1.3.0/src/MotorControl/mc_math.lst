 467:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c **** {
 468:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c **** 
 469:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   int16_t hAngle;
 470:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   int32_t wXi, wYi, wXold;
 471:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c **** 
 472:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   /*Determining quadrant*/
 473:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   if ( wBemf_alfa_est < 0 )
 474:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   {
 475:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     if ( wBemf_beta_est < 0 )
 476:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     {
 477:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****       /*Quadrant III, add 90 degrees so as to move to quadrant IV*/
 478:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****       hAngle = 16384;
 479:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****       wXi = - ( wBemf_beta_est / 2 );
 480:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****       wYi = wBemf_alfa_est / 2;
 481:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     }
 482:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     else
 483:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     {
 484:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****       /*Quadrant II, subtract 90 degrees so as to move to quadrant I*/
 485:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****       hAngle = -16384;
 486:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****       wXi = wBemf_beta_est / 2;
 487:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****       wYi = - ( wBemf_alfa_est / 2 );
 488:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     }
 489:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   }
 490:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   else
 491:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   {
 492:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     /* Quadrant I or IV*/
 493:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     hAngle = 0;
 494:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     wXi = wBemf_alfa_est / 2;
 495:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     wYi = wBemf_beta_est / 2;
 496:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   }
 497:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   wXold = wXi;
 498:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c **** 
 499:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   /*begin the successive approximation process*/
 500:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   /*iteration0*/
 501:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   if ( wYi < 0 )
 502:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****   {
 503:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     /*vector is in Quadrant IV*/
 504:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     hAngle += ATAN1DIV1;
 505:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_math.c ****     wXi = wXi - wYi;
