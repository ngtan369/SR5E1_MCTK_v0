 134:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c **** /**
 135:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   * @brief  Set the modality of the speed and torque controller. Two modality
 136:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         are available Torque mode and Speed mode.
 137:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         In Torque mode is possible to set directly the motor torque
 138:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         reference or execute a motor torque ramp. This value represents
 139:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         actually the Iq current reference expressed in digit.
 140:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         In Speed mode is possible to set the mechanical rotor speed
 141:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         reference or execute a speed ramp. The required motor torque is
 142:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         automatically calculated by the STC.
 143:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         This command interrupts the execution of any previous ramp command
 144:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         maintaining the last value of Iq.
 145:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   * @param  pHandle: handler of the current instance of the SpeednTorqCtrl component
 146:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   * @param  bMode modality of STC. It can be one of these two settings:
 147:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         STC_TORQUE_MODE to enable the Torque mode or STC_SPEED_MODE to
 148:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   *         enable the Speed mode.
 149:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   * @retval none
 150:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c ****   */
 151:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/speed_torq_ctrl.c **** __weak void STC_SetControlMode( SpeednTorqCtrl_Handle_t * pHandle, STC_Modality_t bMode )
