 311:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c **** /**
 312:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   * @brief  This method must be called - at least - with the same periodicity
 313:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         on which speed control is executed.
 314:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         This method compute and store rotor istantaneous el speed (express
 315:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         in dpp considering the measurement frequency) in order to provide it
 316:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         to HALL_CalcElAngle function and SPD_GetElAngle.
 317:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         Then compute rotor average el speed (express in dpp considering the
 318:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         measurement frequency) based on the buffer filled by IRQ, then - as
 319:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         a consequence - compute, store and return - through parameter
 320:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         hMecSpeedUnit - the rotor average mech speed, expressed in Unit.
 321:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         Then check, store and return the reliability state of
 322:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         the sensor; in this function the reliability is measured with
 323:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         reference to specific parameters of the derived
 324:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         sensor (HALL) through internal variables managed by IRQ.
 325:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   * @param  pHandle: handler of the current instance of the hall_speed_pos_fdbk component
 326:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   * @param  hMecSpeedUnit pointer to int16_t, used to return the rotor average
 327:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         mechanical speed (expressed in the unit defined by #SPEED_UNIT)
 328:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   * @retval true = sensor information is reliable
 329:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   *         false = sensor information is not reliable
 330:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c ****   */
 331:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/hall_speed_pos_fdbk.c **** __weak bool HALL_CalcAvrgMecSpeedUnit( HALL_Handle_t * pHandle, int16_t * hMecSpeedUnit )
