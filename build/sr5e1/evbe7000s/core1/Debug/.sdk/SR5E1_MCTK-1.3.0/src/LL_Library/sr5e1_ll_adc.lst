  39:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** 
  40:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /* Private types -------------------------------------------------------------*/
  41:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /* Private variables ---------------------------------------------------------*/
  42:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /* Private constants ---------------------------------------------------------*/
  43:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /** @addtogroup ADC_LL_Private_Constants
  44:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   * @{
  45:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   */
  46:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** 
  47:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /* Definitions of ADC hardware constraints delays */
  48:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /* Note: Only ADC peripheral HW delays are defined in ADC LL driver driver,   */
  49:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       not timeout values:                                                  */
  50:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       Timeout values for ADC operations are dependent to device clock      */
  51:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       configuration (system clock versus ADC clock),                       */
  52:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       and therefore must be defined in user application.                   */
  53:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       Refer to @ref ADC_LL_EC_HW_DELAYS for description of ADC timeout     */
  54:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       values definition.                                                   */
  55:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /* Note: ADC timeout values are defined here in CPU cycles to be independent  */
  56:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       of device clock setting.                                             */
  57:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       In user application, ADC timeout values should be defined with       */
  58:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       temporal values, in function of device clock settings.               */
  59:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*       Highest ratio CPU clock frequency vs ADC clock frequency:            */
  60:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*        - ADC clock from synchronous clock with AHB prescaler 512,          */
  61:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*          ADC prescaler 4.                                                  */
  62:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*           Ratio max = 512 *4 = 2048                                        */
  63:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*        - ADC clock from asynchronous clock (PLLP) with prescaler 256.      */
  64:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*          Highest CPU clock PLL (PLLR).                                     */
  65:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*           Ratio max = PLLRmax /PPLPmin * 256 = (VCO/2) / (VCO/31) * 256    */
  66:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /*                     = 3968                                                 */
  67:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /* Unit: CPU cycles.                                                          */
  68:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** #define ADC_CLOCK_RATIO_VS_CPU_HIGHEST          (3968UL)
  69:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** #define ADC_TIMEOUT_DISABLE_CPU_CYCLES          (ADC_CLOCK_RATIO_VS_CPU_HIGHEST * 1UL)
  70:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** #define ADC_TIMEOUT_STOP_CONVERSION_CPU_CYCLES  (ADC_CLOCK_RATIO_VS_CPU_HIGHEST * 1UL)
  71:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** 
  72:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /**
