4891:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              ADC_SMPR1_SMP0 << ((Channel & ADC_CHANNEL_SMPx_BITOFFSET_MASK) >> ADC_CHANNEL_SMPx_BIT
4892:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              SamplingTime   << ((Channel & ADC_CHANNEL_SMPx_BITOFFSET_MASK) >> ADC_CHANNEL_SMPx_BIT
4893:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** }
