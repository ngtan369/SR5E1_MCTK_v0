 307:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** /**
 308:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   * @brief  De-initialize registers of all ADC instances belonging to
 309:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *         the same ADC common instance to their default reset values.
 310:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   * @note   This function is performing a hard reset, using high level
 311:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *         clock source RCC ADC reset.
 312:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *         Caution: On this SR5E1 series, if several ADC instances are available
 313:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *         on the selected device, RCC ADC reset will reset
 314:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *         all ADC instances belonging to the common ADC instance.
 315:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *         To de-initialize only 1 ADC instance, use
 316:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *         function @ref LL_ADC_DeInit().
 317:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   * @param  ADCxy_COMMON ADC common instance
 318:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *         (can be set directly from CMSIS definition or by using helper macro @ref __LL_ADC_COMMO
 319:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   * @retval An ErrorStatus enumeration value:
 320:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *          - SUCCESS: ADC common registers are de-initialized
 321:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   *          - ERROR: not applicable
 322:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   */
 323:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** ErrorStatus LL_ADC_CommonDeInit(ADC_Common_TypeDef *ADCxy_COMMON)
 324:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** {
 535              		.loc 1 324 1
 536              		.cfi_startproc
 537              		@ args = 0, pretend = 0, frame = 16
 538              		@ frame_needed = 0, uses_anonymous_args = 0
 539              		@ link register save eliminated.
 540 0000 84B0     		sub	sp, sp, #16
 541              		.cfi_def_cfa_offset 16
 542 0002 0190     		str	r0, [sp, #4]
 325:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   /* Check the parameters */
 326:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   assert_param(IS_ADC_COMMON_INSTANCE(ADCxy_COMMON));
 327:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c **** 
 328:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_ll_adc.c ****   if (ADCxy_COMMON == ADC12_COMMON)
 543              		.loc 1 328 6
 544 0004 019B     		ldr	r3, [sp, #4]
 545 0006 1B4A     		ldr	r2, .L44
 546 0008 9342     		cmp	r3, r2
 547 000a 17D1     		bne	.L41
 548 000c 0123     		movs	r3, #1
 549 000e 0393     		str	r3, [sp, #12]
 550              	.LBB14:
 551              	.LBB15:
 552              	.LBB16:
