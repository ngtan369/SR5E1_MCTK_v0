 430:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* Delay for DAC channel voltage settling time from DAC channel startup       */
 431:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* (transition from disable to enable).                                       */
 432:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* Note: DAC channel startup time depends on board application environment:   */
 433:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*       impedance connected to DAC channel output.                           */
 434:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*       The delay below is specified under conditions:                       */
 435:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*        - voltage maximum transition (lowest to highest value)              */
 436:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*        - until voltage reaches final value +-1LSB                          */
 437:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*        - DAC channel output buffer enabled                                 */
 438:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*        - load impedance of 5kOhm (min), 50pF (max)                         */
 439:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* Literal set to maximum value (refer to device datasheet,                   */
 440:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* parameter "tWAKEUP").                                                      */
 441:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* Unit: us                                                                   */
 442:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** #define LL_DAC_DELAY_STARTUP_VOLTAGE_SETTLING_US             8U  /*!< Delay for DAC channel voltage
 443:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 444:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* Delay for DAC channel voltage settling time.                               */
 445:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* Note: DAC channel startup time depends on board application environment:   */
 446:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*       impedance connected to DAC channel output.                           */
 447:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*       The delay below is specified under conditions:                       */
 448:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*        - voltage maximum transition (lowest to highest value)              */
 449:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*        - until voltage reaches final value +-1LSB                          */
 450:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*        - DAC channel output buffer enabled                                 */
 451:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /*        - load impedance of 5kOhm min, 50pF max                             */
 452:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* Literal set to maximum value (refer to device datasheet,                   */
 453:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* parameter "tSETTLING").                                                    */
 454:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* Unit: us                                                                   */
 455:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** #define LL_DAC_DELAY_VOLTAGE_SETTLING_US                     3U  /*!< Delay for DAC channel voltage
 456:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 457:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 458:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @}
 459:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 460:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 461:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 462:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @}
 463:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 464:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 465:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /* Exported macro ------------------------------------------------------------*/
 466:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /** @defgroup DAC_LL_Exported_Macros DAC Exported Macros
 467:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @{
 468:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 469:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 470:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /** @defgroup DAC_LL_EM_WRITE_READ Common write and read registers macros
 471:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @{
 472:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 473:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 474:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 475:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Write a value in DAC register
 476:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __INSTANCE__ DAC Instance
 477:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __REG__ Register to be written
 478:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __VALUE__ Value to be written in the register
 479:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval None
 480:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 481:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** #define LL_DAC_WriteReg(__INSTANCE__, __REG__, __VALUE__) WRITE_REG(__INSTANCE__->__REG__, (__VALUE
 482:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 483:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 484:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Read a value in DAC register
 485:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __INSTANCE__ DAC Instance
 486:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __REG__ Register to be read
 487:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval Register value
 488:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 489:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** #define LL_DAC_ReadReg(__INSTANCE__, __REG__) READ_REG(__INSTANCE__->__REG__)
 490:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 491:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 492:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @}
 493:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 494:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 495:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /** @defgroup DAC_LL_EM_HELPER_MACRO DAC helper macro
 496:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @{
 497:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 498:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 499:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 500:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Helper macro to get DAC channel number in decimal format
 501:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         from literals LL_DAC_CHANNEL_x.
 502:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         Example:
 503:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *            __LL_DAC_CHANNEL_TO_DECIMAL_NB(LL_DAC_CHANNEL_1)
 504:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *            will return decimal number "1".
 505:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   The input can be a value from functions where a channel
 506:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         number is returned.
 507:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __CHANNEL__ This parameter can be one of the following values:
 508:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_1
 509:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_2 (1)
 510:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *
 511:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         (1) On this SR5E1 series, parameter not available on all instances.
 512:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *             Refer to device datasheet for channels availability.
 513:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval 1...2
 514:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 515:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** #define __LL_DAC_CHANNEL_TO_DECIMAL_NB(__CHANNEL__)                            \
 516:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   ((__CHANNEL__) & DAC_SWTR_CHX_MASK)
 517:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 518:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 519:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Helper macro to get DAC channel in literal format LL_DAC_CHANNEL_x
 520:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         from number in decimal format.
 521:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         Example:
 522:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *           __LL_DAC_DECIMAL_NB_TO_CHANNEL(1)
 523:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *           will return a data equivalent to "LL_DAC_CHANNEL_1".
 524:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note  If the input parameter does not correspond to a DAC channel,
 525:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *        this macro returns value '0'.
 526:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __DECIMAL_NB__ 1...2
 527:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval Returned value can be one of the following values:
 528:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_1
 529:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_2 (1)
 530:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *
 531:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         (1) On this SR5E1 series, parameter not available on all instances.
 532:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *             Refer to device datasheet for channels availability.
 533:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 534:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** #define __LL_DAC_DECIMAL_NB_TO_CHANNEL(__DECIMAL_NB__)                         \
 535:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   (((__DECIMAL_NB__) == 1U)                                                    \
 536:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****     ? (                                                                        \
 537:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****        LL_DAC_CHANNEL_1                                                        \
 538:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****       )                                                                        \
 539:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****       :                                                                        \
 540:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****       (((__DECIMAL_NB__) == 2U)                                                \
 541:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****         ? (                                                                    \
 542:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****            LL_DAC_CHANNEL_2                                                    \
 543:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****           )                                                                    \
 544:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****           :                                                                    \
 545:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****           (                                                                    \
 546:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****            0U                                                                  \
 547:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****           )                                                                    \
 548:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****       )                                                                        \
 549:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   )
 550:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 551:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 552:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Helper macro to define the DAC conversion data full-scale digital
 553:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         value corresponding to the selected DAC resolution.
 554:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   DAC conversion data full-scale corresponds to voltage range
 555:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         determined by analog voltage references Vref+ and Vref-
 556:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         (refer to reference manual).
 557:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __DAC_RESOLUTION__ This parameter can be one of the following values:
 558:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_RESOLUTION_12B
 559:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_RESOLUTION_8B
 560:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval ADC conversion data equivalent voltage value (unit: mVolt)
 561:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 562:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** #define __LL_DAC_DIGITAL_SCALE(__DAC_RESOLUTION__)                             \
 563:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   ((0x00000FFFU) >> ((__DAC_RESOLUTION__) << 1U))
 564:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 565:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 566:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Helper macro to calculate the DAC conversion data (unit: digital
 567:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         value) corresponding to a voltage (unit: mVolt).
 568:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   This helper macro is intended to provide input data in voltage
 569:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         rather than digital value,
 570:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         to be used with LL DAC functions such as
 571:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @ref LL_DAC_ConvertData12RightAligned().
 572:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   Analog reference voltage (Vref+) must be either known from
 573:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         user board environment or can be calculated using ADC measurement
 574:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         and ADC helper macro @ref __LL_ADC_CALC_VREFANALOG_VOLTAGE().
 575:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __VREFANALOG_VOLTAGE__ Analog reference voltage (unit: mV)
 576:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __DAC_VOLTAGE__ Voltage to be generated by DAC channel
 577:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *                         (unit: mVolt).
 578:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __DAC_RESOLUTION__ This parameter can be one of the following values:
 579:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_RESOLUTION_12B
 580:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_RESOLUTION_8B
 581:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval DAC conversion data (unit: digital value)
 582:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 583:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** #define __LL_DAC_CALC_VOLTAGE_TO_DATA(__VREFANALOG_VOLTAGE__,\
 584:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****                                       __DAC_VOLTAGE__,\
 585:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****                                       __DAC_RESOLUTION__)                      \
 586:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   ((__DAC_VOLTAGE__) * __LL_DAC_DIGITAL_SCALE(__DAC_RESOLUTION__)              \
 587:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****    / (__VREFANALOG_VOLTAGE__)                                                  \
 588:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   )
 589:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
 590:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
 591:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Helper macro to format sawtooth wave generation configuration
 592:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         value to be filled into WaveAutoGenerationConfig  parameter of @ref LL_DAC_InitTypeDef.
 593:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   This helper will format information to fit in DAC_STRx register.
 594:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __POLARITY__ sawtooth wave polarity (must be value of @ref DAC_LL_EC_SAWTOOTH_POLARITY_
 595:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __RESET_DATA__ sawtooth reset data.
 596:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  __STEP_DATA__ sawtooth step data
 597:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval Sawtooth configuration organized in DAC_STRx compatible format.
 598:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
 599:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** #define __LL_DAC_FORMAT_SAWTOOTHWAVECONFIG(__POLARITY__,\
 600:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****                                            __RESET_DATA__,\
 601:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****                                            __STEP_DATA__)                        \
 602:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   ( (((__STEP_DATA__) << DAC_STR1_STINCDATA1_Pos) & DAC_STR1_STINCDATA1_Msk)     \
 603:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****     | ((__POLARITY__) & DAC_STR1_STDIR1_Msk)                                    \
 604:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****     | (((__RESET_DATA__) << DAC_STR1_STRSTDATA1_Pos) & DAC_STR1_STRSTDATA1_Msk) \
 605:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   )
 606:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** 
