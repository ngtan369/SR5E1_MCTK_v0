1435:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Set the output for the selected DAC channel.
1436:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   This function set several features:
1437:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         - mode normal or sample-and-hold
1438:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         - buffer
1439:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         - connection to GPIO or internal path.
1440:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         These features can also be set individually using
1441:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         dedicated functions:
1442:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         - @ref LL_DAC_SetOutputBuffer()
1443:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         - @ref LL_DAC_SetOutputMode()
1444:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         - @ref LL_DAC_SetOutputConnection()
1445:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   On this SR5E1 series, output connection depends on output mode
1446:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         (normal or sample and hold) and output buffer state.
1447:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         - if output connection is set to internal path and output buffer
1448:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *           is enabled (whatever output mode):
1449:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *           output connection is also connected to GPIO pin
1450:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *           (both connections to GPIO pin and internal path).
1451:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         - if output connection is set to GPIO pin, output buffer
1452:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *           is disabled, output mode set to sample and hold:
1453:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *           output connection is also connected to internal path
1454:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *           (both connections to GPIO pin and internal path).
1455:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   Mode sample-and-hold requires an external capacitor
1456:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         to be connected between DAC channel output and ground.
1457:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         Capacitor value depends on load on DAC channel output and
1458:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         sample-and-hold timings configured.
1459:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         As indication, capacitor typical value is 100nF
1460:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         (refer to device datasheet, parameter "CSH").
1461:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @rmtoll CR       MODE1          LL_DAC_ConfigOutput\n
1462:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         CR       MODE2          LL_DAC_ConfigOutput
1463:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  DACx DAC instance
1464:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  DAC_Channel This parameter can be one of the following values:
1465:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_1
1466:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_2 (1)
1467:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *
1468:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         (1) On this SR5E1 series, parameter not available on all instances.
1469:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *             Refer to device datasheet for channels availability.
1470:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  OutputMode This parameter can be one of the following values:
1471:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_OUTPUT_MODE_NORMAL
1472:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_OUTPUT_MODE_SAMPLE_AND_HOLD
1473:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  OutputBuffer This parameter can be one of the following values:
1474:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_OUTPUT_BUFFER_ENABLE
1475:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_OUTPUT_BUFFER_DISABLE
1476:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  OutputConnection This parameter can be one of the following values:
1477:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_OUTPUT_CONNECT_GPIO
1478:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_OUTPUT_CONNECT_INTERNAL
1479:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval None
1480:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
