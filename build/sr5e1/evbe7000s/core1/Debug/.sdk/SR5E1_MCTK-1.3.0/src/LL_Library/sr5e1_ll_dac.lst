2021:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
2022:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Enable DAC selected channel.
2023:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @rmtoll CR       EN1            LL_DAC_Enable\n
2024:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         CR       EN2            LL_DAC_Enable
2025:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   After enable from off state, DAC channel requires a delay
2026:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         for output voltage to reach accuracy +/- 1 LSB.
2027:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         Refer to device datasheet, parameter "tWAKEUP".
2028:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  DACx DAC instance
2029:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  DAC_Channel This parameter can be one of the following values:
2030:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_1
2031:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_2 (1)
2032:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *
2033:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         (1) On this SR5E1 series, parameter not available on all instances.
2034:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *             Refer to device datasheet for channels availability.
2035:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval None
