1486:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****              (OutputMode | OutputBuffer | OutputConnection) << (DAC_Channel & DAC_CR_CHX_BITOFFSET_
