1905:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
1906:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** __STATIC_INLINE uint32_t LL_DAC_IsDMAReqEnabled(DAC_TypeDef *DACx, uint32_t DAC_Channel)
1907:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** {
1908:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   return ((READ_BIT(DACx->CR,
1909:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****                     DAC_CR_DMAEN1 << (DAC_Channel & DAC_CR_CHX_BITOFFSET_MASK))
