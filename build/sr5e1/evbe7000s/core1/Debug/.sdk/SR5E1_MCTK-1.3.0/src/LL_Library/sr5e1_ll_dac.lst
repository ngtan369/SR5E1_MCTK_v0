1803:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_1
1804:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_2 (1)
1805:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *
1806:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         (1) On this SR5E1 series, parameter not available on all instances.
1807:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *             Refer to device datasheet for channels availability.
1808:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  SignedFormat This parameter can be one of the following values:
1809:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_SIGNED_FORMAT_ENABLE
1810:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_SIGNED_FORMAT_DISABLE
1811:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval None
1812:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
1813:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** __STATIC_INLINE void LL_DAC_SetSignedFormat(DAC_TypeDef *DACx, uint32_t DAC_Channel, uint32_t Signe
1814:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** {
1815:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   MODIFY_REG(DACx->MCR,
1816:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****              DAC_MCR_SINFORMAT1 << (DAC_Channel & DAC_CR_CHX_BITOFFSET_MASK),
1817:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****              SignedFormat << (DAC_Channel & DAC_CR_CHX_BITOFFSET_MASK));
1818:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** }
