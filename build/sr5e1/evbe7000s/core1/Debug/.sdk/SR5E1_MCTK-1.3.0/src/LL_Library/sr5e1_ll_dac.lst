1972:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
1973:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @brief  Function to help to configure DMA transfer to DAC: retrieve the
1974:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         DAC register address from DAC instance and a list of DAC registers
1975:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         intended to be used (most commonly) with DMA transfer.
1976:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   These DAC registers are data holding registers:
1977:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         when DAC conversion is requested, DAC generates a DMA transfer
1978:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         request to have data available in DAC data holding registers.
1979:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @note   This macro is intended to be used with LL DMA driver, refer to
1980:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         function "LL_DMA_ConfigAddresses()".
1981:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         Example:
1982:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *           LL_DMA_ConfigAddresses(DMA1,
1983:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *                                  LL_DMA_CHANNEL_1,
1984:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *                                  (uint32_t)&< array or variable >,
1985:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *                                  LL_DAC_DMA_GetRegAddr(DAC1, LL_DAC_CHANNEL_1, LL_DAC_DMA_REG_D
1986:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *                                  LL_DMA_DIRECTION_MEMORY_TO_PERIPH);
1987:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @rmtoll DHR12R1  DACC1DHR       LL_DAC_DMA_GetRegAddr\n
1988:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         DHR12L1  DACC1DHR       LL_DAC_DMA_GetRegAddr\n
1989:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         DHR8R1   DACC1DHR       LL_DAC_DMA_GetRegAddr\n
1990:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         DHR12R2  DACC2DHR       LL_DAC_DMA_GetRegAddr\n
1991:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         DHR12L2  DACC2DHR       LL_DAC_DMA_GetRegAddr\n
1992:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         DHR8R2   DACC2DHR       LL_DAC_DMA_GetRegAddr
1993:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  DACx DAC instance
1994:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  DAC_Channel This parameter can be one of the following values:
1995:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_1
1996:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_CHANNEL_2 (1)
1997:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *
1998:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         (1) On this SR5E1 series, parameter not available on all instances.
1999:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *             Refer to device datasheet for channels availability.
2000:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @param  Register This parameter can be one of the following values:
2001:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_DMA_REG_DATA_12BITS_RIGHT_ALIGNED
2002:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_DMA_REG_DATA_12BITS_LEFT_ALIGNED
2003:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   *         @arg @ref LL_DAC_DMA_REG_DATA_8BITS_RIGHT_ALIGNED
2004:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @retval DAC register address
2005:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   */
2006:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** __STATIC_INLINE uint32_t LL_DAC_DMA_GetRegAddr(DAC_TypeDef *DACx, uint32_t DAC_Channel, uint32_t Re
2007:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** {
2008:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   /* Retrieve address of register DHR12Rx, DHR12Lx or DHR8Rx depending on     */
2009:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   /* DAC channel selected.                                                    */
2010:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   return ((uint32_t)(__DAC_PTR_REG_OFFSET((DACx)->DHR12R1,
2011:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****                                           ((DAC_Channel >> (Register & 0x1FUL)) & DAC_REG_DHR_REGOF
2012:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** }
2013:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h **** /**
2014:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_dac.h ****   * @}
