  26:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** /**
  27:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * @addtogroup STELLAR_PMSM_MC_UI_LIBRARY
  28:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * @{
  29:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  */
  30:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 
  31:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** /**
  32:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * @addtogroup MCUI
  33:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * @{
  34:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  */
  35:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 
  36:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** /**
  37:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * @defgroup motor_control_protocol Motor Control Protocol
  38:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  *
  39:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * @brief Transmission protocol designed to report Motor Control subsystem status and to control mo
  40:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  *
  41:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * The Motor Control Protocol defines a transmission mechanism that allows a Motor Control
  42:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * Application to send in real time the values of a defined set of internal variables to an
  43:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * external recipient and to receive Motor Control commands from this recipient.
  44:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  *
  45:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * The Commands that can be sent with the Motor Control Protocol are defined in **TBD**.
  46:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  *
  47:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * The variables which values can be exchanged through the Motor Control Protocol are listed in
  48:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * @ref MC_Protocol_REG.
  49:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  *
  50:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * An example of external recipient is the Motor Control Monitor tool that is part of the Motor
  51:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * Control Workbench.
  52:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  *
  53:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * The Motor Control Protocol defines frames that contain either commands or variables values.
  54:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * These frames are the exchanged between the Application and the external recipient. To that end,
  55:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * the Motor Control Protocol relies on a lower level transport protocol to actually send them.
  56:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  *
  57:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * @todo Complete documentation
  58:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  * @{
  59:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****  */
  60:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 
  61:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** /* Private define ------------------------------------------------------------*/
  62:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 
  63:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** #define ACK_NOERROR 0xF0
  64:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** #define ACK_ERROR   0xFF
  65:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** #define ATR_FRAME_START 0xE0
  66:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 
  67:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** #define MC_PROTOCOL_CODE_NONE        0x00
  68:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 
  69:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** /**
  70:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** * @brief  Function used to decode received data
  71:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** *
  72:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** * @param  pHandle Pointer on the handle of the component.
  73:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** * @param  Code code value of frame to send.
  74:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** * @param  buffer frame data buffer.
  75:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** * @param  Size size of data frame.
  76:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** */
  77:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** /* To change endianess when read 4 bytes from memory and sent over UART byte by byte */
  78:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** #define SWAP_ENDIAN_32(value) \
  79:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** { \
  80:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****     int32_t swappedvalue; \
  81:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****     swappedvalue = ((value>>24)&0xff) | ((value<<8)&0xff0000) |((value>>8)&0xff00) | ((value<<24)&0
  82:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c ****     value = swappedvalue; \
  83:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** }
  84:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 
  85:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** /* List of error codes */
  86:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** typedef enum ERROR_CODE_e
  87:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** {
  88:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_NONE = 0,             /**<  0x00 - No error */
  89:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_BAD_FRAME_ID,         /**<  0x01 - BAD Frame ID. The Frame ID has not been recognized by the
  90:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_CODE_SET_READ_ONLY,   /**<  0x02 - Write on read-only. The master wants to write on a read-o
  91:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_CODE_GET_WRITE_ONLY,  /**<  0x03 - Read not allowed. The value cannot be read. */
  92:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_CODE_NO_TARGET_DRIVE, /**<  0x04 - Bad target drive. The target motor is not supported by th
  93:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_CODE_WRONG_SET,       /**<  0x05 - Value used in the frame is out of range expected by the F
  94:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_CODE_CMD_ID,          /**<  0x06 - NOT USED */
  95:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_CODE_WRONG_CMD,       /**<  0x07 - Bad command ID. The command ID has not been recognized. *
  96:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_CODE_OVERRUN,         /**<  0x08 - Overrun error. Transmission speed too fast, frame not rec
  97:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_CODE_TIMEOUT,         /**<  0x09 - Timeout error. Received frame corrupted or unrecognized b
  98:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_CODE_BAD_CRC,         /**<  0x0A - The computed CRC is not equal to the received CRC byte. *
  99:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_BAD_MOTOR_SELECTED,   /**<  0x0B - Bad target drive. The target motor is not supported by th
 100:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** 	ERROR_MP_NOT_ENABLED        /**<  0x0C - Motor Profiler not enabled. */
 101:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/motor_control_protocol.c **** } ERROR_CODE;
