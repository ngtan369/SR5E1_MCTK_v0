  75:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c **** /**
  76:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   * @brief  This is a buffered command to set a motor speed ramp. This commands
  77:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         don't become active as soon as it is called but it will be executed
  78:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         when the pSTM state is START_RUN or RUN. User can check the status
  79:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         of the command calling the MCI_IsCommandAcknowledged method.
  80:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   * @param  pHandle Pointer on the component instance to operate on.
  81:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   * @param  hFinalSpeed is the value of mechanical rotor speed reference at the
  82:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         end of the ramp expressed in tenths of HZ.
  83:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   * @param  hDurationms the duration of the ramp expressed in milliseconds. It
  84:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         is possible to set 0 to perform an instantaneous change in the
  85:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         value.
  86:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   * @retval none.
  87:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   */
  88:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c **** __weak void MCI_ExecSpeedRamp( MCI_Handle_t * pHandle,  int16_t hFinalSpeed, uint16_t hDurationms )
