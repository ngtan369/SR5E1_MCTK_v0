 197:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c **** /**
 198:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   * @brief  This is a user command used to begin the stop motor procedure.
 199:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         If the state machine is in RUN or START states the command is
 200:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         executed instantaneously otherwise the command is discarded. User
 201:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         must take care of this possibility by checking the return value.\n
 202:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         <B>Note:</B> The MCI_StopMotor command is used just to begin the
 203:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         stop motor procedure moving the state machine to ANY_STOP.
 204:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         The command MCI_StopMotor is not blocking the execution of project
 205:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         until the motor is really stopped; to do this, the user have to
 206:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         check the state machine and verify that the IDLE state has been
 207:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         reached again.
 208:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   * @param  pHandle Pointer on the component instance to work on.
 209:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   * @retval bool It returns true if the command is successfully executed
 210:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   *         otherwise it return false.
 211:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c ****   */
 212:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c **** __weak bool MCI_StopMotor( MCI_Handle_t * pHandle )
 213:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/mc_interface.c **** {
