 535:src-gen/sr5e1/clock.h **** #define CLOCK_PLL0IN                CLOCK_CFG_XOSCCLK
 536:src-gen/sr5e1/clock.h **** 
 537:src-gen/sr5e1/clock.h **** #elif CLOCK_CFG_PLL0SRC == CLOCK_PLL0SRC_IRCOSC
 538:src-gen/sr5e1/clock.h **** #define CLOCK_PLL0IN                CLOCK_IRCOSCCLK
 539:src-gen/sr5e1/clock.h **** 
 540:src-gen/sr5e1/clock.h **** #elif CLOCK_CFG_PLL0SRC == CLOCK_PLL0SRC_NOCLOCK
 541:src-gen/sr5e1/clock.h **** #define CLOCK_PLL0IN                0U
 542:src-gen/sr5e1/clock.h **** 
 543:src-gen/sr5e1/clock.h **** #else
 544:src-gen/sr5e1/clock.h **** #error "invalid CLOCK_CFG_PLL0SRC value in clock_cfg.h"
 545:src-gen/sr5e1/clock.h **** #endif
 546:src-gen/sr5e1/clock.h **** 
 547:src-gen/sr5e1/clock.h **** #if (CLOCK_PLL0IN == 0U) && (CLOCK_ACTIVATE_PLL0 == TRUE)
 548:src-gen/sr5e1/clock.h **** #error "no PLL input clock"
 549:src-gen/sr5e1/clock.h **** #endif
 550:src-gen/sr5e1/clock.h **** 
 551:src-gen/sr5e1/clock.h **** #if ((CLOCK_PLL0IN != 0U) && (CLOCK_ACTIVATE_PLL0 == TRUE)) &&              \
 552:src-gen/sr5e1/clock.h ****     ((CLOCK_PLL0IN < CLOCK_PLL0IN_MIN) || (CLOCK_PLL0IN > CLOCK_PLL0IN_MAX))
 553:src-gen/sr5e1/clock.h **** #error "out of limits CLOCK_PLL0IN value"
 554:src-gen/sr5e1/clock.h **** #endif
 555:src-gen/sr5e1/clock.h **** 
 556:src-gen/sr5e1/clock.h **** /* PLL0 VCO clock.*/
