 558:src-gen/sr5e1/clock.h **** #define CLOCK_PLL0VCO               0U
 559:src-gen/sr5e1/clock.h **** #else
 560:src-gen/sr5e1/clock.h **** #define CLOCK_PLL0VCO                                                       \
 561:src-gen/sr5e1/clock.h ****   ((2U * CLOCK_CFG_PLL0MFD_VALUE * CLOCK_PLL0IN) / CLOCK_CFG_PLL0PREDIV_VALUE)
 562:src-gen/sr5e1/clock.h **** #endif
 563:src-gen/sr5e1/clock.h **** 
 564:src-gen/sr5e1/clock.h **** #if (CLOCK_PLL0VCO != 0U) && (CLOCK_ACTIVATE_PLL0 == TRUE) &&               \
 565:src-gen/sr5e1/clock.h ****     ((CLOCK_PLL0VCO < CLOCK_PLL0VCO_MIN) || (CLOCK_PLL0VCO > CLOCK_PLL0VCO_MAX))
 566:src-gen/sr5e1/clock.h **** #error "out of limits CLOCK_PLL0VCO value"
 567:src-gen/sr5e1/clock.h **** #endif
 568:src-gen/sr5e1/clock.h **** 
