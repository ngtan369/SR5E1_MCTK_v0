 572:src-gen/sr5e1/clock.h **** 
 573:src-gen/sr5e1/clock.h **** #if (CLOCK_ACTIVATE_PLL0 == TRUE) &&                                        \
 574:src-gen/sr5e1/clock.h ****     ((CLOCK_PLL0PHI < CLOCK_PLL0PHI_MIN) || (CLOCK_PLL0PHI > CLOCK_PLL0PHI_MAX))
 575:src-gen/sr5e1/clock.h **** #error "out of limits CLOCK_PLL0PHI value"
 576:src-gen/sr5e1/clock.h **** #endif
 577:src-gen/sr5e1/clock.h **** 
 578:src-gen/sr5e1/clock.h **** #define CLOCK_PLL0PHI1                                                      \
 579:src-gen/sr5e1/clock.h ****   ((CLOCK_PLL0VCO / CLOCK_CFG_PLL0RFDPHI1_VALUE) / 2U)
 580:src-gen/sr5e1/clock.h **** 
 581:src-gen/sr5e1/clock.h **** #if (CLOCK_ACTIVATE_PLL0 == TRUE) &&                                        \
 582:src-gen/sr5e1/clock.h ****     ((CLOCK_PLL0PHI1 < CLOCK_PLL0PHI1_MIN) || (CLOCK_PLL0PHI1 > CLOCK_PLL0PHI1_MAX))
 583:src-gen/sr5e1/clock.h **** #error "out of limits CLOCK_PLL0PHI1 value"
 584:src-gen/sr5e1/clock.h **** #endif
