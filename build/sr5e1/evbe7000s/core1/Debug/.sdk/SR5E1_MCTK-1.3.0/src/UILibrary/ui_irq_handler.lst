  14:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** *   @brief   This file provides firmware functions that implement the UI IRQ Handler
  15:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** *            of the Stellar Motor Control.
  16:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** *          
  17:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** *   @details This file provides firmware functions that implement the UI IRQ Handler
  18:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** *            of the Stellar Motor Control.
  19:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** *
  20:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** */
  21:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /* Includes ------------------------------------------------------------------*/
  22:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** #include "ui_irq_handler.h"
  23:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** #include "mc_type.h"
  24:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  25:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  26:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /** @addtogroup STELLAR_PMSM_MC_UI_LIBRARY
  27:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * @{
  28:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   */
  29:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  30:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /**
  31:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****  * @addtogroup MCUI
  32:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****  * @{
  33:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****  */
  34:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  35:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /** @defgroup UI_IRQ_HANDLER MC IRQ Handler Component
  36:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * @brief Performs registration and execution of Interrupts handlers for the UI
  37:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  38:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  This component is a temporary work around allowing to use the former IRQ Handler
  39:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * registration mechanism with both the old Classes and the new Components.
  40:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  41:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  The former mechanism is defined in the UIIRQHandlerClass and is basically playing
  42:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * two roles.
  43:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  44:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  The first one is to register an Object and a method of that object to be executed
  45:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * when an given interrupt occurs. Interrupt sources are identified by a number; 1
  46:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * such sources are defined:
  47:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  48:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * - #UI_IRQ_USART
  49:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  50:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  The second is to provide a function that executes the Interrupt handler
  51:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * registered for a given interrupt source.
  52:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  53:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  The implementation of the UIIRQHandlerClass mandated that the first field of the
  54:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * structure of the registered Object be a pointer on the interrupt handling function to
  55:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * execute.
  56:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  57:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  This constraint is unacceptable for Components and this is the reason why
  58:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * this work-around is proposed.
  59:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  60:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  It is only a work around as the actual interrupt handling method to be used
  61:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * on the 5.0.0 onwards will rely on Cube FW mechanisms and is still TBD in details.
  62:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  63:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  This work around is designed to work both with remanants of the former 4.3 architecture and
  64:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * with the new components from the 5.0 architecture. It minimizes the changes to be made in the
  65:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * legacy 4.3 code by providing two macros named after the UIIRQHandlerClass methods:
  66:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  67:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * - #Set_UI_IRQ_Handler
  68:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * - #Exec_UI_IRQ_Handler
  69:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  70:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  And it provides two functions, similar to the former UIIRQHandlerClass's methods, but designed
  71:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * to work with the new components.
  72:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * @{
  73:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   */
  74:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  75:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  76:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /* Private typedef -----------------------------------------------------------*/
  77:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /**
  78:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * @brief Interrupt handling configuration structure
  79:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *
  80:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   *  The #Handler field is a pointer on the Interrupt handling function, while the
  81:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * #Handle field is a pointer that is passed as the first parameter to the interrupt
  82:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   * handling function when it is executed.
  83:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****   */
  84:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** typedef struct
  85:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** {
  86:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****     UIIRQ_Handler_t Handler;
  87:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c ****     void *          Handle;
  88:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** } UIIRQ_HandlerConfigItem_t;
  89:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  90:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  91:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /* Private defines -----------------------------------------------------------*/
  92:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /** @brief Number of Interrupt handlers managed by the UI IRQ component */
  93:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** #define MAX_UI_IRQ_NUM 1
  94:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  95:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
  96:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /* Static variables ----------------------------------------------------------*/
  97:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** /** @brief Table containing the Interrupt handling configurations */
  98:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** static UIIRQ_HandlerConfigItem_t oUI_IRQTable[MAX_UI_IRQ_NUM];
  99:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
 100:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/ui_irq_handler.c **** 
