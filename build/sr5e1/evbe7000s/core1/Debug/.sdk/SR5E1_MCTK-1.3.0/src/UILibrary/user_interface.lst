  47:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c **** 
  48:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c **** /** @defgroup MCUI Motor Control User Interface
  49:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @brief User Interface Components of the Motor Control SDK
  50:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   *
  51:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * These components aim at connecting the Application with the outside. There are two categories
  52:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * of UI Componentes:
  53:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   *
  54:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * - Some connect the application with the Motor Conrol Monitor tool via a UART link. The Motor
  55:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   *   Control Monitor can control the motor(s) driven by the application and also read and write
  56:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   *   internal variables of the Motor Control subsystem.
  57:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * - Others UI components allow for using the DAC(s) peripherals in
  58:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   *   order to output internal variables of the Motor Control subsystem for debug purposes.
  59:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   *
  60:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @{
  61:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   */
  62:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c **** 
  63:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c **** /**
  64:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @brief  Initialize the user interface component.
  65:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   *
  66:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * Perform the link between the UI, MC interface and MC tuning components.
  67:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c **** 
  68:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @param  pHandle: Pointer on Handle structure of UI component.
  69:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @param  bMCNum  Number of MC instance present in the list.
  70:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @param  pMCI Pointer on the list of MC interface component to inked with UI.
  71:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @param  pMCT Pointer on the list of MC tuning component to inked with UI.
  72:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @param  pUICfg Pointer on the user interface configuration list.
  73:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   *         Each element of the list must be a bit field containing one (or more) of
  74:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   *         the exported configuration option UI_CFGOPT_xxx (eventually OR-ed).
  75:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @retval none.
  76:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   */
