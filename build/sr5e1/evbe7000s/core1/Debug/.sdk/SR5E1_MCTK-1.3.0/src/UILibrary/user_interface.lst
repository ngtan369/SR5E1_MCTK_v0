  44:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c **** /** @addtogroup STELLAR_PMSM_MC_UI_LIBRARY
  45:.sdk/SR5E1_MCTK-1.3.0/src/UILibrary/user_interface.c ****   * @{
