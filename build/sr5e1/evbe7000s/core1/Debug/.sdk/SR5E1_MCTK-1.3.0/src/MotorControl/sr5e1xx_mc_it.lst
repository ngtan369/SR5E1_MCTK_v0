1726:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_UART_HWFLOW_INSTANCE(USARTx) can be used to check whether or not
1727:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Hardware Flow control feature is supported by the USARTx instance.
1728:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR3          RTSE          LL_USART_GetHWFlowCtrl\n
1729:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          CTSE          LL_USART_GetHWFlowCtrl
1730:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
1731:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval Returned value can be one of the following values:
1732:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         @arg @ref LL_USART_HWCONTROL_NONE
1733:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         @arg @ref LL_USART_HWCONTROL_RTS
1734:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         @arg @ref LL_USART_HWCONTROL_CTS
1735:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         @arg @ref LL_USART_HWCONTROL_RTS_CTS
1736:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
1737:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE uint32_t LL_USART_GetHWFlowCtrl(USART_TypeDef *USARTx)
1738:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
