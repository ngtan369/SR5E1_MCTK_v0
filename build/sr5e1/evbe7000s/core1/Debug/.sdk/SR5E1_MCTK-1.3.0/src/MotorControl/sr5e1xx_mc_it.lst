4150:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @rmtoll SMCR         SMSPE           LL_TIM_DisableSMSPreload
4151:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  TIMx Timer instance
4152:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval None
4153:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
4154:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE void LL_TIM_DisableSMSPreload(TIM_TypeDef *TIMx)
4155:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
4156:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   CLEAR_BIT(TIMx->SMCR, TIM_SMCR_SMSPE);
4157:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
4158:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
4159:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** /**
4160:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Indicate whether  SMS preload is enabled.
4161:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @note Macro IS_TIM_SMS_PRELOAD_INSTANCE(TIMx) can be used to check
4162:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *       whether or not a timer instance supports the preload of SMS field in SMCR register.
4163:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @rmtoll SMCR         SMSPE           LL_TIM_IsEnabledSMSPreload
4164:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  TIMx Timer instance
4165:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval State of bit (1 or 0).
4166:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
4167:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE uint32_t LL_TIM_IsEnabledSMSPreload(TIM_TypeDef *TIMx)
4168:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
4169:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   return ((READ_BIT(TIMx->SMCR, TIM_SMCR_SMSPE) == (TIM_SMCR_SMSPE)) ? 1UL : 0UL);
4170:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
4171:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
4172:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** /**
4173:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Set the preload source of SMS.
4174:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @note Macro IS_TIM_SMS_PRELOAD_INSTANCE(TIMx) can be used to check
4175:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *       whether or not a timer instance supports the preload of SMS field in SMCR register.
4176:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @rmtoll SMCR         SMSPS        LL_TIM_SetSMSPreloadSource\n
4177:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  TIMx Timer instance
4178:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  PreloadSource This parameter can be one of the following values:
4179:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_SMSPS_TIMUPDATE
4180:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_SMSPS_INDEX
4181:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval None
4182:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
4183:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE void LL_TIM_SetSMSPreloadSource(TIM_TypeDef *TIMx, uint32_t PreloadSource)
4184:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
4185:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   MODIFY_REG(TIMx->SMCR, TIM_SMCR_SMSPS, PreloadSource);
4186:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
4187:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
4188:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** /**
4189:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Get the preload source of SMS.
4190:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @note Macro IS_TIM_SMS_PRELOAD_INSTANCE(TIMx) can be used to check
4191:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *       whether or not a timer instance supports the preload of SMS field in SMCR register.
4192:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @rmtoll SMCR         SMSPS        LL_TIM_GetSMSPreloadSource\n
4193:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  TIMx Timer instance
4194:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval Returned value can be one of the following values:
4195:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_SMSPS_TIMUPDATE
4196:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_SMSPS_INDEX
4197:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
4198:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE uint32_t LL_TIM_GetSMSPreloadSource(TIM_TypeDef *TIMx)
4199:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
4200:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   return (uint32_t)(READ_BIT(TIMx->SMCR, TIM_SMCR_SMSPS));
4201:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
4202:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
