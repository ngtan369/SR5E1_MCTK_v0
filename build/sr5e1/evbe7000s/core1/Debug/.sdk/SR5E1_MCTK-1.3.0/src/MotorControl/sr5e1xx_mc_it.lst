5836:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   * @retval Shift This parameter can be one of the following values:
5837:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_SHIFT_NONE
5838:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_SHIFT_RIGHT_1
5839:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_SHIFT_RIGHT_2
5840:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_SHIFT_RIGHT_3
5841:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_SHIFT_RIGHT_4
5842:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_SHIFT_RIGHT_5
5843:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_SHIFT_RIGHT_6
5844:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_SHIFT_RIGHT_7
5845:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @arg @ref LL_ADC_OVS_SHIFT_RIGHT_8
5846:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   */
5847:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** __STATIC_INLINE uint32_t LL_ADC_GetOverSamplingShift(ADC_TypeDef *ADCx)
5848:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** {
5849:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   return (uint32_t)(READ_BIT(ADCx->CFGR2, ADC_CFGR2_OVSS));
