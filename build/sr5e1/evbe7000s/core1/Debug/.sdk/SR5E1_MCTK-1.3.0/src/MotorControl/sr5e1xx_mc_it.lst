2006:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** /**
2007:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Set the timer counter counting mode.
2008:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @note Macro IS_TIM_COUNTER_MODE_SELECT_INSTANCE(TIMx) can be used to
2009:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *       check whether or not the counter mode selection feature is supported
2010:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *       by a timer instance.
2011:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @note Switching from Center Aligned counter mode to Edge counter mode (or reverse)
2012:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *       requires a timer reset to avoid unexpected direction
2013:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *       due to DIR bit readonly in center aligned mode.
2014:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @rmtoll CR1          DIR           LL_TIM_SetCounterMode\n
2015:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         CR1          CMS           LL_TIM_SetCounterMode
2016:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  TIMx Timer instance
2017:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  CounterMode This parameter can be one of the following values:
2018:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_COUNTERMODE_UP
2019:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_COUNTERMODE_DOWN
2020:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_COUNTERMODE_CENTER_UP
2021:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_COUNTERMODE_CENTER_DOWN
2022:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_COUNTERMODE_CENTER_UP_DOWN
2023:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval None
2024:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
2025:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE void LL_TIM_SetCounterMode(TIM_TypeDef *TIMx, uint32_t CounterMode)
2026:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
2027:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   MODIFY_REG(TIMx->CR1, (TIM_CR1_DIR | TIM_CR1_CMS), CounterMode);
2028:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
2029:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
2030:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** /**
2031:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Get actual counter mode.
2032:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @note Macro IS_TIM_COUNTER_MODE_SELECT_INSTANCE(TIMx) can be used to
