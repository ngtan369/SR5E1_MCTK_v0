4749:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** __STATIC_INLINE void LL_ADC_INJ_ConfigQueueContext(ADC_TypeDef *ADCx,
4750:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                                    uint32_t TriggerSource,
4751:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                                    uint32_t ExternalTriggerEdge,
4752:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                                    uint32_t SequencerNbRanks,
4753:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                                    uint32_t Rank1_Channel,
4754:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                                    uint32_t Rank2_Channel,
4755:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                                    uint32_t Rank3_Channel,
4756:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                                    uint32_t Rank4_Channel)
4757:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** {
4758:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   /* Set bits with content of parameter "Rankx_Channel" with bits position    */
4759:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   /* in register depending on literal "LL_ADC_INJ_RANK_x".                    */
4760:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   /* Parameters "Rankx_Channel" and "LL_ADC_INJ_RANK_x" are used with masks   */
4761:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   /* because containing other bits reserved for other purpose.                */
4762:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   /* If parameter "TriggerSource" is set to SW start, then parameter          */
4763:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   /* "ExternalTriggerEdge" is discarded.                                      */
4764:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   uint32_t is_trigger_not_sw = (uint32_t)((TriggerSource != LL_ADC_INJ_TRIG_SOFTWARE) ? 1UL : 0UL);
4765:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   MODIFY_REG(ADCx->JSQR,
4766:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              ADC_JSQR_JEXTSEL |
4767:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              ADC_JSQR_JEXTEN  |
4768:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              ADC_JSQR_JSQ4    |
4769:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              ADC_JSQR_JSQ3    |
4770:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              ADC_JSQR_JSQ2    |
4771:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              ADC_JSQR_JSQ1    |
4772:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              ADC_JSQR_JL,
4773:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              (TriggerSource & ADC_JSQR_JEXTSEL)          |
4774:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              (ExternalTriggerEdge * (is_trigger_not_sw)) |
4775:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              (((Rank4_Channel & ADC_CHANNEL_ID_NUMBER_MASK) >> ADC_CHANNEL_ID_NUMBER_BITOFFSET_POS)
4776:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              (((Rank3_Channel & ADC_CHANNEL_ID_NUMBER_MASK) >> ADC_CHANNEL_ID_NUMBER_BITOFFSET_POS)
4777:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              (((Rank2_Channel & ADC_CHANNEL_ID_NUMBER_MASK) >> ADC_CHANNEL_ID_NUMBER_BITOFFSET_POS)
4778:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              (((Rank1_Channel & ADC_CHANNEL_ID_NUMBER_MASK) >> ADC_CHANNEL_ID_NUMBER_BITOFFSET_POS)
4779:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****              SequencerNbRanks
4780:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****             );
4781:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** }
