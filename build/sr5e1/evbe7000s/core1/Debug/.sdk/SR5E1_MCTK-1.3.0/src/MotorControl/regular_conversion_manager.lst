 417:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** 
 418:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** /**
 419:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   * @brief  Structure definition of some features of ADC instance.
 420:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   * @note   These parameters have an impact on ADC scope: ADC instance.
 421:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         Affects both group regular and group injected (availability
 422:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         of ADC group injected depends on families).
 423:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         Refer to corresponding unitary functions into
 424:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         @ref ADC_LL_EF_Configuration_ADC_Instance .
 425:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   * @note   The setting of these parameters by function @ref LL_ADC_Init()
 426:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         is conditioned to ADC state:
 427:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         ADC instance must be disabled.
 428:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         This condition is applied to all ADC features, for efficiency
 429:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         and compatibility over all families. However, the different
 430:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         features can be set under different ADC state conditions
 431:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         (setting possible with ADC enabled without conversion on going,
 432:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         ADC enabled with conversion on going, ...)
 433:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         Each feature can be updated afterwards with a unitary function
 434:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         and potentially with ADC in a different state than disabled,
 435:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         refer to description of each function for setting
 436:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   *         conditioned to ADC state.
 437:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   */
 438:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** typedef struct
 439:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** {
 440:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   uint32_t Resolution;                  /*!< Set ADC resolution.
 441:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                              This parameter can be a value of @ref ADC_LL_EC_RESOLU
 442:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** 
 443:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                              This feature can be modified afterwards using unitary 
 444:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** 
 445:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   uint32_t DataAlignment;               /*!< Set ADC conversion data alignment.
 446:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                              This parameter can be a value of @ref ADC_LL_EC_DATA_A
 447:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** 
 448:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                              This feature can be modified afterwards using unitary 
 449:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** 
 450:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****   uint32_t LowPowerMode;                /*!< Set ADC low power mode.
 451:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                              This parameter can be a value of @ref ADC_LL_EC_LP_MOD
 452:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** 
 453:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h ****                                              This feature can be modified afterwards using unitary 
 454:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** 
 455:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** } LL_ADC_InitTypeDef;
 456:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_adc.h **** 
