 103:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c **** /**
 104:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   * @brief Number of regular conversion allowed By default.
 105:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   *
 106:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   * In single drive configuration, it is defined to 4. 2 of them are consumed by
 107:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   * Bus voltage and temperature reading. This leaves 2 handles available for
 108:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   * user conversions
 109:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   *
 110:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   * In dual drives configuration, it is defined to 6. 2 of them are consumed by
 111:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   * Bus voltage and temperature reading for each motor. This leaves 2 handles
 112:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   * available for user conversion.
 113:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   *
 114:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   * Defined to 4 here.
 115:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c ****   */
 116:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c **** #define RCM_MAX_CONV  4
 117:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c **** 
 118:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/regular_conversion_manager.c **** /* Global variables ----------------------------------------------------------*/
