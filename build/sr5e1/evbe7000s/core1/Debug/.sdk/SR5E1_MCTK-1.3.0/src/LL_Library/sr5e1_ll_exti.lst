 898:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** /**
 899:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @brief  Enable ExtiLine Rising Edge Trigger for Lines in range 0 to 31
 900:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @note The configurable wakeup lines are edge-triggered. No glitch must be
