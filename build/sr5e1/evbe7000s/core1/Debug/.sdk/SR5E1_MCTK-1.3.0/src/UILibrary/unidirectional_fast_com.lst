2569:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   SET_BIT(USARTx->CR3, USART_CR3_DEM);
2570:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2571:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2572:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2573:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Disable Driver Enable (DE) Mode
2574:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_UART_DRIVER_ENABLE_INSTANCE(USARTx) can be used to check whether or not
2575:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Driver Enable feature is supported by the USARTx instance.
2576:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR3          DEM           LL_USART_DisableDEMode
2577:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2578:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
2579:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2580:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE void LL_USART_DisableDEMode(USART_TypeDef *USARTx)
2581:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2582:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR3, USART_CR3_DEM);
2583:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2584:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2585:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2586:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Indicate if Driver Enable (DE) Mode is enabled
2587:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_UART_DRIVER_ENABLE_INSTANCE(USARTx) can be used to check whether or not
2588:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Driver Enable feature is supported by the USARTx instance.
2589:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR3          DEM           LL_USART_IsEnabledDEMode
2590:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2591:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval State of bit (1 or 0).
2592:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2593:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE uint32_t LL_USART_IsEnabledDEMode(USART_TypeDef *USARTx)
2594:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2595:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   return ((READ_BIT(USARTx->CR3, USART_CR3_DEM) == (USART_CR3_DEM)) ? 1UL : 0UL);
2596:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2597:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2598:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2599:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Select Driver Enable Polarity
2600:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_UART_DRIVER_ENABLE_INSTANCE(USARTx) can be used to check whether or not
2601:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Driver Enable feature is supported by the USARTx instance.
2602:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR3          DEP           LL_USART_SetDESignalPolarity
2603:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2604:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  Polarity This parameter can be one of the following values:
2605:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         @arg @ref LL_USART_DE_POLARITY_HIGH
2606:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         @arg @ref LL_USART_DE_POLARITY_LOW
2607:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
2608:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2609:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE void LL_USART_SetDESignalPolarity(USART_TypeDef *USARTx, uint32_t Polarity)
2610:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2611:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   MODIFY_REG(USARTx->CR3, USART_CR3_DEP, Polarity);
2612:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2613:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2614:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2615:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Return Driver Enable Polarity
2616:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_UART_DRIVER_ENABLE_INSTANCE(USARTx) can be used to check whether or not
2617:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Driver Enable feature is supported by the USARTx instance.
2618:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR3          DEP           LL_USART_GetDESignalPolarity
2619:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2620:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval Returned value can be one of the following values:
2621:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         @arg @ref LL_USART_DE_POLARITY_HIGH
2622:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         @arg @ref LL_USART_DE_POLARITY_LOW
2623:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2624:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE uint32_t LL_USART_GetDESignalPolarity(USART_TypeDef *USARTx)
2625:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2626:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   return (uint32_t)(READ_BIT(USARTx->CR3, USART_CR3_DEP));
2627:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2628:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2629:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2630:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @}
2631:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2632:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2633:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /** @defgroup USART_LL_EF_AdvancedConfiguration Advanced Configurations services
2634:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @{
2635:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2636:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2637:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2638:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Perform basic configuration of USART for enabling use in Asynchronous Mode (UART)
2639:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   In UART mode, the following bits must be kept cleared:
2640:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - LINEN bit in the USART_CR2 register,
2641:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - CLKEN bit in the USART_CR2 register,
2642:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - SCEN bit in the USART_CR3 register,
2643:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - IREN bit in the USART_CR3 register,
2644:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - HDSEL bit in the USART_CR3 register.
2645:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Call of this function is equivalent to following function call sequence :
2646:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear LINEN in CR2 using @ref LL_USART_DisableLIN() function
2647:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear CLKEN in CR2 using @ref LL_USART_DisableSCLKOutput() function
2648:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear SCEN in CR3 using @ref LL_USART_DisableSmartcard() function
2649:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear IREN in CR3 using @ref LL_USART_DisableIrda() function
2650:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear HDSEL in CR3 using @ref LL_USART_DisableHalfDuplex() function
2651:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Other remaining configurations items related to Asynchronous Mode
2652:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         (as Baud Rate, Word length, Parity, ...) should be set using
2653:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         dedicated functions
2654:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR2          LINEN         LL_USART_ConfigAsyncMode\n
2655:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          CLKEN         LL_USART_ConfigAsyncMode\n
2656:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          SCEN          LL_USART_ConfigAsyncMode\n
2657:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          IREN          LL_USART_ConfigAsyncMode\n
2658:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          HDSEL         LL_USART_ConfigAsyncMode
2659:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2660:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
2661:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2662:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE void LL_USART_ConfigAsyncMode(USART_TypeDef *USARTx)
2663:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2664:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* In Asynchronous mode, the following bits must be kept cleared:
2665:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - LINEN, CLKEN bits in the USART_CR2 register,
2666:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - SCEN, IREN and HDSEL bits in the USART_CR3 register.
2667:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2668:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR2, (USART_CR2_LINEN | USART_CR2_CLKEN));
2669:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR3, (USART_CR3_SCEN | USART_CR3_IREN | USART_CR3_HDSEL));
2670:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2671:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2672:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2673:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Perform basic configuration of USART for enabling use in Synchronous Mode
2674:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   In Synchronous mode, the following bits must be kept cleared:
2675:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - LINEN bit in the USART_CR2 register,
2676:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - SCEN bit in the USART_CR3 register,
2677:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - IREN bit in the USART_CR3 register,
2678:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - HDSEL bit in the USART_CR3 register.
2679:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         This function also sets the USART in Synchronous mode.
2680:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_USART_INSTANCE(USARTx) can be used to check whether or not
2681:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Synchronous mode is supported by the USARTx instance.
2682:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Call of this function is equivalent to following function call sequence :
2683:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear LINEN in CR2 using @ref LL_USART_DisableLIN() function
2684:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear IREN in CR3 using @ref LL_USART_DisableIrda() function
2685:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear SCEN in CR3 using @ref LL_USART_DisableSmartcard() function
2686:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear HDSEL in CR3 using @ref LL_USART_DisableHalfDuplex() function
2687:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Set CLKEN in CR2 using @ref LL_USART_EnableSCLKOutput() function
2688:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Other remaining configurations items related to Synchronous Mode
2689:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         (as Baud Rate, Word length, Parity, Clock Polarity, ...) should be set using
2690:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         dedicated functions
2691:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR2          LINEN         LL_USART_ConfigSyncMode\n
2692:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          CLKEN         LL_USART_ConfigSyncMode\n
2693:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          SCEN          LL_USART_ConfigSyncMode\n
2694:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          IREN          LL_USART_ConfigSyncMode\n
2695:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          HDSEL         LL_USART_ConfigSyncMode
2696:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2697:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
2698:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2699:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE void LL_USART_ConfigSyncMode(USART_TypeDef *USARTx)
2700:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2701:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* In Synchronous mode, the following bits must be kept cleared:
2702:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - LINEN bit in the USART_CR2 register,
2703:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - SCEN, IREN and HDSEL bits in the USART_CR3 register.
2704:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2705:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR2, (USART_CR2_LINEN));
2706:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR3, (USART_CR3_SCEN | USART_CR3_IREN | USART_CR3_HDSEL));
2707:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* set the UART/USART in Synchronous mode */
2708:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   SET_BIT(USARTx->CR2, USART_CR2_CLKEN);
2709:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2710:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2711:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2712:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Perform basic configuration of USART for enabling use in LIN Mode
2713:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   In LIN mode, the following bits must be kept cleared:
2714:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - STOP and CLKEN bits in the USART_CR2 register,
2715:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - SCEN bit in the USART_CR3 register,
2716:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - IREN bit in the USART_CR3 register,
2717:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - HDSEL bit in the USART_CR3 register.
2718:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         This function also set the UART/USART in LIN mode.
2719:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_UART_LIN_INSTANCE(USARTx) can be used to check whether or not
2720:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         LIN feature is supported by the USARTx instance.
2721:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Call of this function is equivalent to following function call sequence :
2722:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear CLKEN in CR2 using @ref LL_USART_DisableSCLKOutput() function
2723:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear STOP in CR2 using @ref LL_USART_SetStopBitsLength() function
2724:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear SCEN in CR3 using @ref LL_USART_DisableSmartcard() function
2725:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear IREN in CR3 using @ref LL_USART_DisableIrda() function
2726:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear HDSEL in CR3 using @ref LL_USART_DisableHalfDuplex() function
2727:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Set LINEN in CR2 using @ref LL_USART_EnableLIN() function
2728:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Other remaining configurations items related to LIN Mode
2729:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         (as Baud Rate, Word length, LIN Break Detection Length, ...) should be set using
2730:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         dedicated functions
2731:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR2          CLKEN         LL_USART_ConfigLINMode\n
2732:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          STOP          LL_USART_ConfigLINMode\n
2733:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          LINEN         LL_USART_ConfigLINMode\n
2734:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          IREN          LL_USART_ConfigLINMode\n
2735:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          SCEN          LL_USART_ConfigLINMode\n
2736:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          HDSEL         LL_USART_ConfigLINMode
2737:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2738:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
2739:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2740:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE void LL_USART_ConfigLINMode(USART_TypeDef *USARTx)
2741:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2742:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* In LIN mode, the following bits must be kept cleared:
2743:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - STOP and CLKEN bits in the USART_CR2 register,
2744:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - IREN, SCEN and HDSEL bits in the USART_CR3 register.
2745:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2746:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR2, (USART_CR2_CLKEN | USART_CR2_STOP));
2747:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR3, (USART_CR3_IREN | USART_CR3_SCEN | USART_CR3_HDSEL));
2748:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* Set the UART/USART in LIN mode */
2749:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   SET_BIT(USARTx->CR2, USART_CR2_LINEN);
2750:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2751:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2752:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2753:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Perform basic configuration of USART for enabling use in Half Duplex Mode
2754:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   In Half Duplex mode, the following bits must be kept cleared:
2755:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - LINEN bit in the USART_CR2 register,
2756:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - CLKEN bit in the USART_CR2 register,
2757:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - SCEN bit in the USART_CR3 register,
2758:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - IREN bit in the USART_CR3 register,
2759:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         This function also sets the UART/USART in Half Duplex mode.
2760:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_UART_HALFDUPLEX_INSTANCE(USARTx) can be used to check whether or not
2761:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Half-Duplex mode is supported by the USARTx instance.
2762:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Call of this function is equivalent to following function call sequence :
2763:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear LINEN in CR2 using @ref LL_USART_DisableLIN() function
2764:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear CLKEN in CR2 using @ref LL_USART_DisableSCLKOutput() function
2765:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear SCEN in CR3 using @ref LL_USART_DisableSmartcard() function
2766:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear IREN in CR3 using @ref LL_USART_DisableIrda() function
2767:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Set HDSEL in CR3 using @ref LL_USART_EnableHalfDuplex() function
2768:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Other remaining configurations items related to Half Duplex Mode
2769:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         (as Baud Rate, Word length, Parity, ...) should be set using
2770:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         dedicated functions
2771:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR2          LINEN         LL_USART_ConfigHalfDuplexMode\n
2772:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          CLKEN         LL_USART_ConfigHalfDuplexMode\n
2773:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          HDSEL         LL_USART_ConfigHalfDuplexMode\n
2774:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          SCEN          LL_USART_ConfigHalfDuplexMode\n
2775:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          IREN          LL_USART_ConfigHalfDuplexMode
2776:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2777:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
2778:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2779:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE void LL_USART_ConfigHalfDuplexMode(USART_TypeDef *USARTx)
2780:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2781:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* In Half Duplex mode, the following bits must be kept cleared:
2782:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - LINEN and CLKEN bits in the USART_CR2 register,
2783:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - SCEN and IREN bits in the USART_CR3 register.
2784:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2785:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR2, (USART_CR2_LINEN | USART_CR2_CLKEN));
2786:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR3, (USART_CR3_SCEN | USART_CR3_IREN));
2787:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* set the UART/USART in Half Duplex mode */
2788:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   SET_BIT(USARTx->CR3, USART_CR3_HDSEL);
2789:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2790:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2791:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2792:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Perform basic configuration of USART for enabling use in Smartcard Mode
2793:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   In Smartcard mode, the following bits must be kept cleared:
2794:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - LINEN bit in the USART_CR2 register,
2795:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - IREN bit in the USART_CR3 register,
2796:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - HDSEL bit in the USART_CR3 register.
2797:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         This function also configures Stop bits to 1.5 bits and
2798:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         sets the USART in Smartcard mode (SCEN bit).
2799:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Clock Output is also enabled (CLKEN).
2800:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_SMARTCARD_INSTANCE(USARTx) can be used to check whether or not
2801:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Smartcard feature is supported by the USARTx instance.
2802:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Call of this function is equivalent to following function call sequence :
2803:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear LINEN in CR2 using @ref LL_USART_DisableLIN() function
2804:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear IREN in CR3 using @ref LL_USART_DisableIrda() function
2805:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear HDSEL in CR3 using @ref LL_USART_DisableHalfDuplex() function
2806:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Configure STOP in CR2 using @ref LL_USART_SetStopBitsLength() function
2807:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Set CLKEN in CR2 using @ref LL_USART_EnableSCLKOutput() function
2808:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Set SCEN in CR3 using @ref LL_USART_EnableSmartcard() function
2809:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Other remaining configurations items related to Smartcard Mode
2810:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         (as Baud Rate, Word length, Parity, ...) should be set using
2811:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         dedicated functions
2812:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR2          LINEN         LL_USART_ConfigSmartcardMode\n
2813:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          STOP          LL_USART_ConfigSmartcardMode\n
2814:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          CLKEN         LL_USART_ConfigSmartcardMode\n
2815:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          HDSEL         LL_USART_ConfigSmartcardMode\n
2816:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          SCEN          LL_USART_ConfigSmartcardMode
2817:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2818:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
2819:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2820:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE void LL_USART_ConfigSmartcardMode(USART_TypeDef *USARTx)
2821:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2822:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* In Smartcard mode, the following bits must be kept cleared:
2823:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - LINEN bit in the USART_CR2 register,
2824:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - IREN and HDSEL bits in the USART_CR3 register.
2825:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2826:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR2, (USART_CR2_LINEN));
2827:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR3, (USART_CR3_IREN | USART_CR3_HDSEL));
2828:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* Configure Stop bits to 1.5 bits */
2829:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* Synchronous mode is activated by default */
2830:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   SET_BIT(USARTx->CR2, (USART_CR2_STOP_0 | USART_CR2_STOP_1 | USART_CR2_CLKEN));
2831:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* set the UART/USART in Smartcard mode */
2832:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   SET_BIT(USARTx->CR3, USART_CR3_SCEN);
2833:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2834:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2835:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2836:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Perform basic configuration of USART for enabling use in Irda Mode
2837:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   In IRDA mode, the following bits must be kept cleared:
2838:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - LINEN bit in the USART_CR2 register,
2839:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - STOP and CLKEN bits in the USART_CR2 register,
2840:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - SCEN bit in the USART_CR3 register,
2841:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - HDSEL bit in the USART_CR3 register.
2842:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         This function also sets the UART/USART in IRDA mode (IREN bit).
2843:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_IRDA_INSTANCE(USARTx) can be used to check whether or not
2844:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         IrDA feature is supported by the USARTx instance.
2845:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Call of this function is equivalent to following function call sequence :
2846:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear LINEN in CR2 using @ref LL_USART_DisableLIN() function
2847:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear CLKEN in CR2 using @ref LL_USART_DisableSCLKOutput() function
2848:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear SCEN in CR3 using @ref LL_USART_DisableSmartcard() function
2849:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear HDSEL in CR3 using @ref LL_USART_DisableHalfDuplex() function
2850:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Configure STOP in CR2 using @ref LL_USART_SetStopBitsLength() function
2851:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Set IREN in CR3 using @ref LL_USART_EnableIrda() function
2852:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Other remaining configurations items related to Irda Mode
2853:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         (as Baud Rate, Word length, Power mode, ...) should be set using
2854:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         dedicated functions
2855:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR2          LINEN         LL_USART_ConfigIrdaMode\n
2856:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          CLKEN         LL_USART_ConfigIrdaMode\n
2857:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          STOP          LL_USART_ConfigIrdaMode\n
2858:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          SCEN          LL_USART_ConfigIrdaMode\n
2859:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          HDSEL         LL_USART_ConfigIrdaMode\n
2860:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          IREN          LL_USART_ConfigIrdaMode
2861:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2862:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
2863:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2864:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE void LL_USART_ConfigIrdaMode(USART_TypeDef *USARTx)
2865:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2866:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* In IRDA mode, the following bits must be kept cleared:
2867:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - LINEN, STOP and CLKEN bits in the USART_CR2 register,
2868:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - SCEN and HDSEL bits in the USART_CR3 register.
2869:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2870:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR2, (USART_CR2_LINEN | USART_CR2_CLKEN | USART_CR2_STOP));
2871:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR3, (USART_CR3_SCEN | USART_CR3_HDSEL));
2872:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* set the UART/USART in IRDA mode */
2873:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   SET_BIT(USARTx->CR3, USART_CR3_IREN);
2874:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2875:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2876:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2877:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  Perform basic configuration of USART for enabling use in Multi processor Mode
2878:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         (several USARTs connected in a network, one of the USARTs can be the master,
2879:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         its TX output connected to the RX inputs of the other slaves USARTs).
2880:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   In MultiProcessor mode, the following bits must be kept cleared:
2881:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - LINEN bit in the USART_CR2 register,
2882:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - CLKEN bit in the USART_CR2 register,
2883:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - SCEN bit in the USART_CR3 register,
2884:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - IREN bit in the USART_CR3 register,
2885:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *           - HDSEL bit in the USART_CR3 register.
2886:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Call of this function is equivalent to following function call sequence :
2887:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear LINEN in CR2 using @ref LL_USART_DisableLIN() function
2888:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear CLKEN in CR2 using @ref LL_USART_DisableSCLKOutput() function
2889:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear SCEN in CR3 using @ref LL_USART_DisableSmartcard() function
2890:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear IREN in CR3 using @ref LL_USART_DisableIrda() function
2891:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         - Clear HDSEL in CR3 using @ref LL_USART_DisableHalfDuplex() function
2892:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Other remaining configurations items related to Multi processor Mode
2893:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         (as Baud Rate, Wake Up Method, Node address, ...) should be set using
2894:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         dedicated functions
2895:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR2          LINEN         LL_USART_ConfigMultiProcessMode\n
2896:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR2          CLKEN         LL_USART_ConfigMultiProcessMode\n
2897:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          SCEN          LL_USART_ConfigMultiProcessMode\n
2898:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          HDSEL         LL_USART_ConfigMultiProcessMode\n
2899:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         CR3          IREN          LL_USART_ConfigMultiProcessMode
2900:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
2901:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
2902:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2903:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE void LL_USART_ConfigMultiProcessMode(USART_TypeDef *USARTx)
2904:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2905:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   /* In Multi Processor mode, the following bits must be kept cleared:
2906:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - LINEN and CLKEN bits in the USART_CR2 register,
2907:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   - IREN, SCEN and HDSEL bits in the USART_CR3 register.
2908:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2909:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR2, (USART_CR2_LINEN | USART_CR2_CLKEN));
2910:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR3, (USART_CR3_SCEN | USART_CR3_HDSEL | USART_CR3_IREN));
2911:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2912:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
2913:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
2914:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @}
2915:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
