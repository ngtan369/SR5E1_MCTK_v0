2041:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval State of bit (1 or 0).
2042:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   */
2043:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** __STATIC_INLINE uint32_t LL_USART_IsEnabledIrda(USART_TypeDef *USARTx)
2044:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** {
2045:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   return ((READ_BIT(USARTx->CR3, USART_CR3_IREN) == (USART_CR3_IREN)) ? 1UL : 0UL);
2046:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
2047:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
