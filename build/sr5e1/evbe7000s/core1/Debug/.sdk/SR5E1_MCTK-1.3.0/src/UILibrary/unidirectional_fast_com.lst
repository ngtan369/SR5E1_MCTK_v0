1507:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
1508:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
