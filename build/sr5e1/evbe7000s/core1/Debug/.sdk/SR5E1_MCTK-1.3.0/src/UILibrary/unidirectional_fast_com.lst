 799:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
 800:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @brief  USART enabled in STOP Mode.
 801:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   When this function is enabled, USART is able to wake up the MCU from Stop mode, provide
 802:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         USART clock selection is HSI or LSE in RCC.
 803:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @note   Macro IS_UART_WAKEUP_FROMSTOP_INSTANCE(USARTx) can be used to check whether or not
 804:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   *         Wake-up from Stop mode feature is supported by the USARTx instance.
 805:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @rmtoll CR1          UESM          LL_USART_EnableInStopMode
 806:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @param  USARTx USART Instance
 807:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   * @retval None
