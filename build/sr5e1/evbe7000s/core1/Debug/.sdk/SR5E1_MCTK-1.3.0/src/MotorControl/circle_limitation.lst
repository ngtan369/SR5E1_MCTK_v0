  47:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   int32_t MaxModule;
  48:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   int32_t square_q;
  49:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   int32_t square_temp;
  50:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   int32_t square_d;
  51:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   int32_t square_sum;
  52:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   int32_t square_limit;
  53:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   int32_t vd_square_limit;
  54:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   int32_t new_q;
  55:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   int32_t new_d;
  56:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   qd_t Local_Vqd=Vqd;
  57:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c **** 
  58:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   MaxModule = pHandle->MaxModule;
  59:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c **** 
  60:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   square_q = (int32_t)(Vqd.q) * Vqd.q;
  61:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   square_d = (int32_t)(Vqd.d) * Vqd.d;
  62:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   square_limit = MaxModule * MaxModule;
  63:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   vd_square_limit = pHandle->MaxVd * pHandle->MaxVd;
  64:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   square_sum = square_q + square_d;
  65:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c **** 
  66:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   if (square_sum > square_limit)
  67:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   {
  68:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****     if(square_d <= vd_square_limit)
  69:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****     {
  70:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       square_temp = square_limit - square_d;
  71:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       new_q = MCM_Sqrt(square_temp);
  72:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       if(Vqd.q < 0)
  73:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       {
  74:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****         new_q = -new_q;
  75:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       }
  76:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       new_d = Vqd.d;
  77:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****     }
  78:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****     else
  79:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****     {
  80:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       new_d = pHandle->MaxVd;
  81:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       if(Vqd.d < 0)
  82:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       {
  83:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****         new_d = -new_d;
  84:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       }
  85:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c **** 
  86:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       square_temp = square_limit - vd_square_limit;
  87:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       new_q = MCM_Sqrt(square_temp);
  88:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       if(Vqd.q < 0)
  89:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       {
  90:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****         new_q = - new_q;
  91:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****       }
  92:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****     }
  93:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****     Local_Vqd.q = new_q;
  94:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****     Local_Vqd.d = new_d;
  95:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   }
  96:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c ****   return(Local_Vqd);
  97:.sdk/SR5E1_MCTK-1.3.0/src/MotorControl/circle_limitation.c **** }
