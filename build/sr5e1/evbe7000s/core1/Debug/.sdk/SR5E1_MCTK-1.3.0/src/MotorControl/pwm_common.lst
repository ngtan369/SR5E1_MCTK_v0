2408:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_LOCKLEVEL_3
2409:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval None
2410:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
2411:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE void LL_TIM_CC_SetLockLevel(TIM_TypeDef *TIMx, uint32_t LockLevel)
2412:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
2413:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   MODIFY_REG(TIMx->BDTR, TIM_BDTR_LOCK, LockLevel);
2414:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
2415:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
