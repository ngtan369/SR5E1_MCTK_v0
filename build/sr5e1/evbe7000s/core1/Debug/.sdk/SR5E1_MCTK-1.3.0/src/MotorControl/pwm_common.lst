1933:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
1934:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** /**
1935:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Indicates whether update event generation is enabled.
1936:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @rmtoll CR1          UDIS          LL_TIM_IsEnabledUpdateEvent
1937:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  TIMx Timer instance
1938:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval Inverted state of bit (0 or 1).
1939:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
1940:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE uint32_t LL_TIM_IsEnabledUpdateEvent(TIM_TypeDef *TIMx)
1941:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
1942:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   return ((READ_BIT(TIMx->CR1, TIM_CR1_UDIS) == (uint32_t)RESET) ? 1UL : 0UL);
1943:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
1944:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
1945:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** /**
1946:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Set update event source
1947:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @note Update event source set to LL_TIM_UPDATESOURCE_REGULAR: any of the following events
1948:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *       generate an update interrupt or DMA request if enabled:
1949:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *        - Counter overflow/underflow
1950:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *        - Setting the UG bit
1951:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *        - Update generation through the slave mode controller
1952:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @note Update event source set to LL_TIM_UPDATESOURCE_COUNTER: only counter
1953:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *       overflow/underflow generates an update interrupt or DMA request if enabled.
1954:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @rmtoll CR1          URS           LL_TIM_SetUpdateSource
1955:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  TIMx Timer instance
1956:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  UpdateSource This parameter can be one of the following values:
1957:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_UPDATESOURCE_REGULAR
1958:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_UPDATESOURCE_COUNTER
1959:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval None
1960:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
1961:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE void LL_TIM_SetUpdateSource(TIM_TypeDef *TIMx, uint32_t UpdateSource)
1962:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
1963:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   MODIFY_REG(TIMx->CR1, TIM_CR1_URS, UpdateSource);
1964:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
1965:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
1966:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** /**
1967:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Get actual event update source
1968:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @rmtoll CR1          URS           LL_TIM_GetUpdateSource
1969:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  TIMx Timer instance
1970:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval Returned value can be one of the following values:
1971:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_UPDATESOURCE_REGULAR
1972:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   *         @arg @ref LL_TIM_UPDATESOURCE_COUNTER
1973:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
1974:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE uint32_t LL_TIM_GetUpdateSource(TIM_TypeDef *TIMx)
1975:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
1976:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   return (uint32_t)(READ_BIT(TIMx->CR1, TIM_CR1_URS));
1977:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
1978:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** 
1979:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** /**
1980:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Set one pulse mode (one shot v.s. repetitive).
