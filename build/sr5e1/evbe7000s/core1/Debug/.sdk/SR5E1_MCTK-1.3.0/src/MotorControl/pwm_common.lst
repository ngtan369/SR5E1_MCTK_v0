1902:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @brief  Indicates whether the timer counter is enabled.
1903:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @rmtoll CR1          CEN           LL_TIM_IsEnabledCounter
1904:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @param  TIMx Timer instance
1905:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   * @retval State of bit (1 or 0).
1906:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   */
1907:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE uint32_t LL_TIM_IsEnabledCounter(TIM_TypeDef *TIMx)
1908:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** {
1909:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h ****   return ((READ_BIT(TIMx->CR1, TIM_CR1_CEN) == (TIM_CR1_CEN)) ? 1UL : 0UL);
1910:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** }
