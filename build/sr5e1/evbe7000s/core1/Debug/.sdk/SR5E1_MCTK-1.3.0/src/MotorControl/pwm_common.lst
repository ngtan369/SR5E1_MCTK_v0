1000:src-gen/sr5e1/clock.h **** /**
1001:src-gen/sr5e1/clock.h ****  * @brief   Enables AHB1 peripherals clock [Low Word]
1002:src-gen/sr5e1/clock.h ****  *
1003:src-gen/sr5e1/clock.h ****  * @param[in] smode     sleep mode (if true, peripheral clock is enabled in
1004:src-gen/sr5e1/clock.h ****  *                      sleep mode)
1005:src-gen/sr5e1/clock.h ****  * @param[in] m         peripheral clock to be enabled
1006:src-gen/sr5e1/clock.h ****  * @return              value of register AHB1LENR after the update
1007:src-gen/sr5e1/clock.h ****  *
1008:src-gen/sr5e1/clock.h ****  * @api
1009:src-gen/sr5e1/clock.h ****  */
1010:src-gen/sr5e1/clock.h **** __STATIC_FORCEINLINE uint32_t clock_enable_AHB1L(bool smode, uint32_t m) {
1011:src-gen/sr5e1/clock.h **** 
1012:src-gen/sr5e1/clock.h ****     RCC->AHB1LENR |= m;
1013:src-gen/sr5e1/clock.h ****     if (smode) {
1014:src-gen/sr5e1/clock.h ****         RCC->C1_AHB1LSMENR |= m;
1015:src-gen/sr5e1/clock.h **** #if CLOCK_CFG_SMP_MODE == TRUE
1016:src-gen/sr5e1/clock.h ****         RCC->C2_AHB1LSMENR |= m;
1017:src-gen/sr5e1/clock.h **** #endif
1018:src-gen/sr5e1/clock.h ****     }
1019:src-gen/sr5e1/clock.h ****     else {
1020:src-gen/sr5e1/clock.h ****         RCC->C1_AHB1LSMENR &= ~m;
1021:src-gen/sr5e1/clock.h **** #if CLOCK_CFG_SMP_MODE == TRUE
1022:src-gen/sr5e1/clock.h ****         RCC->C2_AHB1LSMENR &= ~m;
1023:src-gen/sr5e1/clock.h **** #endif
1024:src-gen/sr5e1/clock.h ****     }
1025:src-gen/sr5e1/clock.h **** 
1026:src-gen/sr5e1/clock.h ****     return RCC->AHB1LENR;
1027:src-gen/sr5e1/clock.h **** }
1028:src-gen/sr5e1/clock.h **** 
1029:src-gen/sr5e1/clock.h **** /**
1030:src-gen/sr5e1/clock.h ****  * @brief   Disables AHB1 peripherals clock [Low Word]
1031:src-gen/sr5e1/clock.h ****  *
