2025:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_tim.h **** __STATIC_INLINE void LL_TIM_SetCounterMode(TIM_TypeDef *TIMx, uint32_t CounterMode)
