 648:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** /**
 649:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   * @brief  Unregister a FDCAN CallBack.
 650:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *         FDCAN callback is redirected to the weak predefined callback
 651:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   * @param  hfdcan pointer to a FDCAN_HandleTypeDef structure that contains
 652:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *         the configuration information for FDCAN module
 653:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   * @param  CallbackID ID of the callback to be unregistered
 654:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *         This parameter can be one of the following values:
 655:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *           @arg @ref HAL_FDCAN_TX_FIFO_EMPTY_CB_ID Tx Fifo Empty callback ID
 656:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *           @arg @ref HAL_FDCAN_HIGH_PRIO_MESSAGE_CB_ID High priority message callback ID
 657:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *           @arg @ref HAL_FDCAN_TIMESTAMP_WRAPAROUND_CB_ID Timestamp wraparound callback ID
 658:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *           @arg @ref HAL_FDCAN_TIMEOUT_OCCURRED_CB_ID Timeout occurred callback ID
 659:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *           @arg @ref HAL_FDCAN_ERROR_CALLBACK_CB_ID Error callback ID
 660:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *           @arg @ref HAL_FDCAN_MSPINIT_CB_ID MspInit callback ID
 661:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   *           @arg @ref HAL_FDCAN_MSPDEINIT_CB_ID MspDeInit callback ID
 662:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   * @retval HAL status
 663:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   */
 664:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** HAL_StatusTypeDef HAL_FDCAN_UnRegisterCallback(FDCAN_HandleTypeDef *hfdcan, HAL_FDCAN_CallbackIDTyp
 665:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** {
 666:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   HAL_StatusTypeDef status = HAL_OK;
 667:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 668:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   if (hfdcan->State == HAL_FDCAN_STATE_READY)
 669:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   {
 670:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****     switch (CallbackID)
 671:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****     {
 672:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       case HAL_FDCAN_TX_FIFO_EMPTY_CB_ID :
 673:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->TxFifoEmptyCallback = HAL_FDCAN_TxFifoEmptyCallback;
 674:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 675:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 676:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       case HAL_FDCAN_HIGH_PRIO_MESSAGE_CB_ID :
 677:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->HighPriorityMessageCallback = HAL_FDCAN_HighPriorityMessageCallback;
 678:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 679:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 680:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       case HAL_FDCAN_TIMESTAMP_WRAPAROUND_CB_ID :
 681:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->TimestampWraparoundCallback = HAL_FDCAN_TimestampWraparoundCallback;
 682:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 683:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 684:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       case HAL_FDCAN_TIMEOUT_OCCURRED_CB_ID :
 685:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->TimeoutOccurredCallback = HAL_FDCAN_TimeoutOccurredCallback;
 686:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 687:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 688:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       case HAL_FDCAN_ERROR_CALLBACK_CB_ID :
 689:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->ErrorCallback = HAL_FDCAN_ErrorCallback;
 690:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 691:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 692:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       case HAL_FDCAN_MSPINIT_CB_ID :
 693:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->MspInitCallback = HAL_FDCAN_MspInit;
 694:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 695:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 696:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       case HAL_FDCAN_MSPDEINIT_CB_ID :
 697:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->MspDeInitCallback = HAL_FDCAN_MspDeInit;
 698:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 699:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 700:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       default :
 701:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         /* Update the error code */
 702:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->ErrorCode |= HAL_FDCAN_ERROR_INVALID_CALLBACK;
 703:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 704:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         /* Return error status */
 705:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         status =  HAL_ERROR;
 706:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 707:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****     }
 708:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   }
 709:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   else if (hfdcan->State == HAL_FDCAN_STATE_RESET)
 710:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   {
 711:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****     switch (CallbackID)
 712:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****     {
 713:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       case HAL_FDCAN_MSPINIT_CB_ID :
