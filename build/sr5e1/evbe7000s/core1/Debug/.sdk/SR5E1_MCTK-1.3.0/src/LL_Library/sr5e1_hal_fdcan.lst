1180:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** @verbatim
1181:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   ==============================================================================
1182:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****               ##### Configuration functions #####
1183:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****   ==============================================================================
1184:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****     [..]  This section provides functions allowing to:
1185:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigFilter                  : Configure the FDCAN reception filters
1186:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigGlobalFilter            : Configure the FDCAN global filter
1187:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigExtendedIdMask          : Configure the extended ID mask
1188:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigRxFifoOverwrite         : Configure the Rx FIFO operation mode
1189:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigRamWatchdog             : Configure the RAM watchdog
1190:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigTimestampCounter        : Configure the timestamp counter
1191:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_EnableTimestampCounter        : Enable the timestamp counter
1192:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_DisableTimestampCounter       : Disable the timestamp counter
1193:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_GetTimestampCounter           : Get the timestamp counter value
1194:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_ResetTimestampCounter         : Reset the timestamp counter to zero
1195:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigTimeoutCounter          : Configure the timeout counter
1196:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_EnableTimeoutCounter          : Enable the timeout counter
1197:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_DisableTimeoutCounter         : Disable the timeout counter
1198:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_GetTimeoutCounter             : Get the timeout counter value
1199:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_ResetTimeoutCounter           : Reset the timeout counter to its start value
1200:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_ConfigTxDelayCompensation     : Configure the transmitter delay compensation
1201:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_EnableTxDelayCompensation     : Enable the transmitter delay compensation
1202:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         (+) HAL_FDCAN_DisableTxDelayCompensation    : Disable the transmitter delay compensation
1203:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_EnableISOMode                 : Enable ISO 11898-1 protocol mode
1204:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_DisableISOMode                : Disable ISO 11898-1 protocol mode
1205:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_EnableEdgeFiltering           : Enable edge filtering during bus integration
1206:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       (+) HAL_FDCAN_DisableEdgeFiltering          : Disable edge filtering during bus integration
1207:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
