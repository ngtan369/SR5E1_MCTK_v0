 718:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->MspDeInitCallback = HAL_FDCAN_MspDeInit;
 719:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 720:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 721:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****       default :
 722:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         /* Update the error code */
 723:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         hfdcan->ErrorCode |= HAL_FDCAN_ERROR_INVALID_CALLBACK;
 724:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c **** 
 725:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         /* Return error status */
 726:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         status =  HAL_ERROR;
 727:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****         break;
 728:.sdk/SR5E1_MCTK-1.3.0/src/LL_Library/sr5e1_hal_fdcan.c ****     }
