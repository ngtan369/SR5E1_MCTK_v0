   1:src/anti_rollback.c **** /*******************************************************************************
   2:src/anti_rollback.c ****   * @file    anti_rollback.c
   3:src/anti_rollback.c ****   * @brief   Anti-Rollback / Hill Start Assist (HSA) Controller Implementation
   4:src/anti_rollback.c ****   * @details Implements a PI controller to generate torque current reference (Iq)
   5:src/anti_rollback.c ****   *          maintaining zero speed on inclines.
   6:src/anti_rollback.c ****   *****************************************************************************/
   7:src/anti_rollback.c **** 
