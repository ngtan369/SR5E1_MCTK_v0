  17:src/anti_rollback.c **** /**
  18:src/anti_rollback.c ****   * @brief Anti-Rollback PI Controller structure definition
  19:src/anti_rollback.c ****   */
  20:src/anti_rollback.c **** typedef struct {
  21:src/anti_rollback.c ****     float32_t kp;               /* Proportional gain */
  22:src/anti_rollback.c ****     float32_t ki;               /* Integral gain */
  23:src/anti_rollback.c ****     float32_t ts;               /* Sampling time in seconds (e.g., 0.001f = 1ms) */
  24:src/anti_rollback.c ****     float32_t integral;         /* Integral term accumulator */
  25:src/anti_rollback.c ****     float32_t iq_out;           /* Output torque current reference */
  26:src/anti_rollback.c ****     float32_t iq_max;           /* Maximum allowable torque current limit */
  27:src/anti_rollback.c ****     float32_t iq_min;           /* Minimum allowable torque current limit */
  28:src/anti_rollback.c ****     float32_t speed_deadband;   /* Speed error deadband threshold (RPM) */
  29:src/anti_rollback.c **** } AntiRollback_PI_t;
  30:src/anti_rollback.c **** 
  31:src/anti_rollback.c **** /* Static controller instance initialization */
  32:src/anti_rollback.c **** static AntiRollback_PI_t hAntiRollback = {
  33:src/anti_rollback.c ****     .kp = 50.0f,
  34:src/anti_rollback.c ****     .ki = 200.0f,
  35:src/anti_rollback.c ****     .ts = 0.002f,
  36:src/anti_rollback.c ****     .integral = 0.0f,
  37:src/anti_rollback.c ****     .iq_out = 0.0f,
  38:src/anti_rollback.c ****     .iq_max = AR_MAX_IQ,
  39:src/anti_rollback.c ****     .iq_min = AR_MIN_IQ,
  40:src/anti_rollback.c ****     .speed_deadband = 1.5f
  41:src/anti_rollback.c **** };
