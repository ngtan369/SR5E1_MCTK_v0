 940:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** /**
 941:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @brief  Enable ExtiLine Rising Edge Trigger for Lines in range 32 to 63
 942:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @note The configurable wakeup lines are edge-triggered. No glitch must be
 943:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       generated on these lines. If a rising edge on a configurable interrupt
 944:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       line occurs during a write operation in the EXTI_RTSR register, the
 945:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       pending bit is not set.Rising and falling edge triggers can be set for
 946:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       the same interrupt line. In this case, both generate a trigger
 947:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       condition.
 948:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @rmtoll RTSR2        RTx           LL_EXTI_EnableRisingTrig_32_63
 949:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @param  ExtiLine This parameter can be a combination of the following values:
 950:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_32
 951:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_33
 952:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_34
 953:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @retval None
 954:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   */
 955:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** __STATIC_INLINE void LL_EXTI_EnableRisingTrig_32_63(uint32_t ExtiLine)
 956:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** {
 957:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   SET_BIT(EXTI->RTSR2, ExtiLine);
 958:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** }
 959:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** 
