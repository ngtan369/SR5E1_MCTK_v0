1181:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** /**
1182:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @brief  Disable ExtiLine Falling Edge Trigger for Lines in range 32 to 63
1183:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @note The configurable wakeup lines are edge-triggered. No glitch must be
1184:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       generated on these lines. If a Falling edge on a configurable interrupt
1185:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       line occurs during a write operation in the EXTI_FTSR register, the
1186:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       pending bit is not set.
1187:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       Rising and falling edge triggers can be set for the same interrupt line.
1188:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *       In this case, both generate a trigger condition.
1189:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @rmtoll FTSR2        FTx           LL_EXTI_DisableFallingTrig_32_63
1190:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @param  ExtiLine This parameter can be a combination of the following values:
1191:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_32
1192:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_33
1193:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_34
1194:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   * @retval None
1195:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   */
1196:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** __STATIC_INLINE void LL_EXTI_DisableFallingTrig_32_63(uint32_t ExtiLine)
1197:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** {
1198:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   CLEAR_BIT(EXTI->FTSR2, ExtiLine);
1199:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h **** }
