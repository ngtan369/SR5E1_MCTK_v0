 633:src/main.c    **** 	 dbg_dutyB_pct = (uint16_t)(((uint32_t)dbg_dutyB * 100U) / (PWM_PERIOD_CYCLES / 2U));
 634:src/main.c    **** 	 dbg_dutyC_pct = (uint16_t)(((uint32_t)dbg_dutyC * 100U) / (PWM_PERIOD_CYCLES / 2U));
