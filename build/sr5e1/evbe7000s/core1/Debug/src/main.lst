1676:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h ****   CLEAR_BIT(USARTx->CR3, USART_CR3_RTSE);
1677:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** }
1678:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** 
1679:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_usart.h **** /**
