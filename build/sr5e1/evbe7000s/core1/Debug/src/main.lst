 922:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_13
 923:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_14
 924:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_15
 925:.sdk/SR5E1_MCTK-1.3.0/include/LL_Library/sr5e1_ll_exti.h ****   *         @arg @ref LL_EXTI_LINE_18
